{% macro sortable_link(column, label, current_sort, current_direction) %}
	{# If the current column is active, we reverse the direction for the next click. #}
	{% set nextDirection = (current_sort == column and current_direction == 'asc') ? 'desc' : 'asc' %}

	{# Merge the current GET parameters (like the search query ?q=) with the new sorting #}
	{% set params = app.request.query.all()|merge({'sort': column, 'direction': nextDirection, 'page': 1}) %}

	<div class="flex items-center">
		<a href="{{ path(app.request.attributes.get('_route'), params) }}" class="font-medium text-gray-500 text-theme-xs dark:text-gray-400 inline-flex gap-1 hover:text-blue-600 dark:hover:text-blue-400">
			{{ label }}
			{% if current_sort == column %}
				{% if current_direction == 'asc' %}
					{{ ux_icon('heroicons:chevron-up', { class: 'w-5 h-5 stroke-gray-500 dark:stroke-gray-400' }) }}
				{% else %}
					{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 stroke-gray-500 dark:stroke-gray-400' }) }}
				{% endif %}
			{% else %}
				{{ ux_icon('heroicons:chevron-up-down', { class: 'w-6 h-6 stroke-gray-500 dark:stroke-gray-400' }) }}
			{% endif %}
		</a>
	</div>
{% endmacro %}
