{% macro sortable_link(column, label, current_sort, current_direction) %}
	{# If the current column is active, we reverse the direction for the next click. #}
	{% set nextDirection = (current_sort == column and current_direction == 'asc') ? 'desc' : 'asc' %}
	{% set isActive = current_sort == column %}
	{% set currentDirectionLabel = current_direction == 'asc' ? 'ascendente' : 'descendente' %}
	{% set nextDirectionLabel = (current_sort == column and current_direction == 'asc') ? 'descendente' : 'ascendente' %}
	{% set ariaLabel = isActive ? 'Cambiar a orden ' ~ nextDirectionLabel ~ ' por ' ~ label : 'Ordenar por ' ~ label %}
	{% set ariaSort = isActive ? (current_direction == 'asc' ? 'ascending' : 'descending') : 'none' %}

	{# Merge the current GET parameters (like the search query ?q=) with the new sorting #}
	{% set params = app.request.query.all()|merge({'sort': column, 'direction': nextDirection, 'page': 1}) %}

	<div class="flex items-center">
		<a href="{{ path(app.request.attributes.get('_route'), params) }}"
			class="inline-flex items-center gap-1 rounded-sm font-medium text-theme-sm transition-colors hover:text-blue-600 dark:hover:text-blue-400 {% if isActive %} text-gray-900 underline decoration-2 underline-offset-4 dark:text-white {% else %} text-gray-500 dark:text-gray-400 {% endif %}"
			data-action="click->admin-paginator#sortColumn"
			data-column="{{ column }}"
			data-direction="{{ nextDirection }}"
			aria-label="{{ ariaLabel }}"
			aria-sort="{{ ariaSort }}"
			title="{{ ariaLabel }}"
			>
			{{ label }}
			{% if isActive %}
				{% if current_direction == 'asc' %}
					{{ ux_icon('heroicons:chevron-up', { class: 'mt-0.5 h-4 w-4 stroke-current' }) }}
				{% else %}
					{{ ux_icon('heroicons:chevron-down', { class: 'mt-0.5 h-4 w-4 stroke-current' }) }}
				{% endif %}
			{% else %}
				{{ ux_icon('heroicons:chevron-up-down', { class: 'mt-0.5 h-5 w-5 stroke-current' }) }}
			{% endif %}
		</a>
	</div>
{% endmacro %}
