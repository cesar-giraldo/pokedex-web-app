{% extends '@admin/base.html.twig' %}

{% block title %}Bar Chart
{% endblock %}

{% block page_title %}
	Bar Chart
{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Bar Chart</li>
{% endblock %}

{% block body %}
	<div class="space-y-6">
		<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
			<div class="px-6 py-5">
				<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
					Ventas del Último año
				</h3>
			</div>
			<div
				class="p-5 border-t border-gray-100 dark:border-gray-800 sm:p-6">
				<!-- ====== Bar Chart Start -->
				<div 
					data-controller="template-bar-chart" 
					data-template-bar-chart-data-value="{{ sells|json_encode }}"
					data-template-bar-chart-categories-value="{{ categories|json_encode }}"
					data-template-bar-chart-label-value="Totales Sales ($)"
					class="max-w-full overflow-x-auto custom-scrollbar">
						<div data-template-bar-chart-target="container" class="min-w-[1000px]"></div>
				</div>
				<!-- ====== Bar Chart End -->
			</div>
		</div>
	</div>
{% endblock %}
