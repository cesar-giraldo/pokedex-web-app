{% extends '@admin/base.html.twig' %}

{% block title %}Buttons
{% endblock %}

{% block page_title %}
	Buttons
{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_design_index') }}">
			UI Kit
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Buttons</li>
{% endblock %}

{% block body %}
	<div class="space-y-5 sm:space-y-6">
		<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
			<div class="px-6 py-5">
				<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
					Primary Button
				</h3>
			</div>
			<div class="border-t border-gray-100 px-6 py-6.5 dark:border-gray-800">
				<div class="flex items-center gap-5">
					<button class="inline-flex items-center gap-2 px-4 py-3 text-sm font-medium text-white transition rounded-lg bg-brand-500 shadow-theme-xs hover:bg-brand-600">
						Button Text
					</button>

					<button class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-5 py-3.5 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600">
						Button Text
					</button>
				</div>

			</div>
		</div>

		<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
