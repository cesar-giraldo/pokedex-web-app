{% extends '@admin/base.html.twig' %}

{% block title %}Forms{% endblock %}

{% block page_title %}
	Forms
{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Forms</li>
{% endblock %}

{% block body %}
	{% set demo_department_options = {
		'marketing': 'Marketing',
		'template': 'Template',
		'development': 'Development',
	} %}
	{% set demo_country_codes = {
		'US': '+1',
		'GB': '+44',
		'CA': '+1',
		'AU': '+61',
	} %}

	<!-- ====== Form Elements Section Start -->
	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
		<div class="space-y-6">
			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Default Inputs
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Input
						</label>
						<input type="text" class="dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
					</div>

					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Input with Placeholder
						</label>
						<input type="text" placeholder="info@gmail.com" class="dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
					</div>

					<!-- Single Select Component -->
					<twig:component_single_select
						label="Select Input"
						name="demo_department"
						id="demo-department-default"
						placeholder="Select Option"
						:options="demo_department_options"
					/>

					<!-- Password Input Component -->
					<twig:component_password_input
						label="Password Input"
						name="demo_password"
						id="demo-password"
						placeholder="Enter your password"
					/>

					<!-- Date Picker Component -->
					<twig:component_date_picker
						label="Date Picker Input"
						name="demo_date"
						id="demo-date"
						placeholder="Select date"
					/>

					<!-- Time Picker Component -->
					<twig:component_time_picker
						label="Time Select Input"
						name="demo_time"
						id="demo-time"
						placeholder="12:00 AM"
					/>

					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Input with Payment
						</label>

						<div class="relative">
							<input type="text" placeholder="Card number" class="dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent bg-none px-4 py-2.5 pl-[62px] text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
							<span class="absolute top-1/2 left-0 flex h-11 w-[46px] -translate-y-1/2 items-center justify-center border-r border-gray-200 dark:border-gray-800">
								{# Master Card Icon #}
								<svg width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
									<circle cx="6.25" cy="10" r="5.625" fill="#E80B26"/>
									<circle cx="13.75" cy="10" r="5.625" fill="#F59D31"/>
									<path d="M10 14.1924C11.1508 13.1625 11.875 11.6657 11.875 9.99979C11.875 8.33383 11.1508 6.8371 10 5.80713C8.84918 6.8371 8.125 8.33383 8.125 9.99979C8.125 11.6657 8.84918 13.1625 10 14.1924Z" fill="#FC6020"/>
								</svg>
							</span>
						</div>
					</div>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Select Inputs
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Single Select: estado por defecto -->
					<twig:component_single_select
						label="Select Input"
						name="demo_department_select"
						id="demo-department-select"
						placeholder="Select Option"
						help="Elige un departamento."
						:options="demo_department_options"
					/>

					<!-- Single Select: con valor inicial -->
					<twig:component_single_select
						label="Select con valor inicial"
						name="demo_department_selected"
						id="demo-department-selected"
						placeholder="Select Option"
						:options="demo_department_options"
						selected="marketing"
					/>

					<!-- Single Select: required + error -->
					<twig:component_single_select
						label="Select requerido"
						name="demo_department_required"
						id="demo-department-required"
						placeholder="Select Option"
						:options="demo_department_options"
						:required="true"
						error="Debes seleccionar una opción."
					/>

					<!-- Single Select: disabled -->
					<twig:component_single_select
						label="Select deshabilitado"
						name="demo_department_disabled"
						id="demo-department-disabled"
						placeholder="Select Option"
						:options="demo_department_options"
						selected="development"
						:disabled="true"
					/>

					{# Mock de variables que en un formulario Symfony vendrían de FormView / DTO #}
					{% set demo_options = {
						'tech': 'Tecnología',
						'sports': 'Deportes',
						'music': 'Música',
						'art': 'Arte',
					} %}

					<!-- Multiple Select: estado por defecto -->
					<twig:component_multi_select
						label="Multiple Select Input"
						name="demo_preferences[]"
						id="demo-preferences"
						placeholder="Elige tus preferencias"
						help="Selecciona una o más categorías de interés."
						:options="demo_options"
					/>

					<!-- Multiple Select: con valores preseleccionados (mock submitted data) -->
					<twig:component_multi_select
						label="Multiple Select con valores iniciales"
						name="demo_interests[]"
						id="demo-interests"
						placeholder="Elige tus intereses"
						:options="demo_options"
						:selected="['tech', 'music']"
					/>

					<!-- Multiple Select: required + error (mock validation) -->
					<twig:component_multi_select
						label="Multiple Select requerido"
						name="demo_required[]"
						id="demo-required"
						placeholder="Selecciona al menos una opción"
						:options="demo_options"
						:required="true"
						error="Debes seleccionar al menos una opción."
					/>

					<!-- Multiple Select: disabled (mock read-only form) -->
					<twig:component_multi_select
						label="Multiple Select deshabilitado"
						name="demo_disabled[]"
						id="demo-disabled"
						placeholder="No editable"
						:options="demo_options"
						:selected="['sports']"
						:disabled="true"
					/>

					<!-- Multiple Select: límite de selección -->
					<twig:component_multi_select
						label="Multiple Select (máx. 2)"
						name="demo_limited[]"
						id="demo-limited"
						placeholder="Elige hasta 2 opciones"
						help="Solo puedes seleccionar un máximo de 2 opciones."
						:options="demo_options"
						:maxSelections="2"
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Textarea input field
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Textarea: estado por defecto -->
					<twig:component_textarea
						label="Description"
						name="demo_description"
						id="demo-description"
						placeholder="Enter a description..."
						:rows="6"
					/>

					<!-- Textarea: disabled -->
					<twig:component_textarea
						label="Description"
						name="demo_description_disabled"
						id="demo-description-disabled"
						placeholder="Enter a description..."
						:rows="6"
						:disabled="true"
					/>

					<!-- Textarea: error -->
					<twig:component_textarea
						label="Description"
						name="demo_description_error"
						id="demo-description-error"
						placeholder="Enter a description..."
						:rows="6"
						error="Please enter a message in the textarea."
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Input States
					</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						Validation styles for error, success and disabled states
												                      on form controls.
					</p>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Email
						</label>
						<div class="relative">
							<input type="text" value="demoemail" class="dark:bg-dark-900 border-error-300 shadow-theme-xs focus:border-error-300 focus:ring-error-500/10 dark:border-error-700 dark:focus:border-error-800 w-full rounded-lg border bg-transparent px-4 py-2.5 pr-10 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
							<span class="absolute top-1/2 right-3.5 -translate-y-1/2 text-error-500 dark:text-error-400">
								{{ ux_icon('heroicons:information-circle', { class: 'w-5 h-5' }) }}
							</span>
						</div>

						<p class="text-theme-xs text-error-500 mt-1.5">
							This is an error message.
						</p>
					</div>

					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Email
						</label>
						<div class="relative">
							<input type="text" value="demoemail@gmail.com" class="dark:bg-dark-900 border-success-300 shadow-theme-xs focus:border-success-300 focus:ring-success-500/10 dark:border-success-700 dark:focus:border-success-800 w-full rounded-lg border bg-transparent px-4 py-2.5 pr-10 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
							<span class="absolute top-1/2 right-3.5 -translate-y-1/2 text-success-500 dark:text-success-400">
								{{ ux_icon('heroicons:check-circle', { class: 'w-5 h-5' }) }}
							</span>
						</div>

						<p class="text-theme-xs text-success-500 mt-1.5">
							This is an success message.
						</p>
					</div>

					<!-- Date Picker: required + error -->
					<twig:component_date_picker
						label="Date"
						name="demo_date_required"
						id="demo-date-required"
						:required="true"
						error="Debes seleccionar una fecha válida."
					/>

					<!-- Date Picker: disabled -->
					<twig:component_date_picker
						label="Date"
						name="demo_date_disabled"
						id="demo-date-disabled"
						value="2026-08-09"
						:disabled="true"
					/>

					<!-- Time Picker: required + error -->
					<twig:component_time_picker
						label="Time"
						name="demo_time_required"
						id="demo-time-required"
						:required="true"
						error="Debes seleccionar una hora válida."
					/>

					<!-- Time Picker: disabled -->
					<twig:component_time_picker
						label="Time"
						name="demo_time_disabled"
						id="demo-time-disabled"
						value="09:30"
						:disabled="true"
					/>

					<!-- Password Input: required + error -->
					<twig:component_password_input
						label="Password"
						name="demo_password_required"
						id="demo-password-required"
						placeholder="Enter your password"
						autocomplete="new-password"
						:required="true"
						error="La contraseña debe tener al menos 8 caracteres."
					/>

					<!-- Password Input: disabled -->
					<twig:component_password_input
						label="Password"
						name="demo_password_disabled"
						id="demo-password-disabled"
						value="secret123"
						:disabled="true"
					/>

					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-300 dark:text-white/15">
							Email
						</label>
						<input type="text" placeholder="info@gmail.com" disabled class="shadow-theme-xs focus:border-brand-300 focus:shadow-focus-ring dark:focus:border-brand-300 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:outline-hidden disabled:border-gray-100 disabled:placeholder:text-gray-300 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-gray-400 dark:disabled:border-gray-800 dark:disabled:placeholder:text-white/15"/>
					</div>
				</div>
			</div>
		</div>

		<div class="space-y-6">
			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Input Group
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Elements -->
					<div>
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Email
						</label>
						<div class="relative">
							<span class="absolute top-1/2 left-0 -translate-y-1/2 border-r border-gray-200 px-3.5 py-3 text-gray-500 dark:border-gray-800 dark:text-gray-400">
								{{ ux_icon('heroicons:envelope', { class: 'w-5 h-5' }) }}
							</span>
							<input type="text" placeholder="info@gmail.com" class="dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pl-[62px] text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
						</div>
					</div>

					<!-- Phone Input: selector de país a la izquierda -->
					<twig:component_phone_input
						label="Phone"
						name="demo_phone_left"
						id="demo-phone-left"
						placeholder="+1 (555) 000-0000"
						:countryCodes="demo_country_codes"
						countrySelectorPosition="left"
					/>

					<!-- Phone Input: selector de país a la derecha -->
					<twig:component_phone_input
						label="Phone"
						name="demo_phone_right"
						id="demo-phone-right"
						placeholder="+1 (555) 000-0000"
						:countryCodes="demo_country_codes"
						countrySelectorPosition="right"
					/>

					<!-- URL Input: estado por defecto -->
					<twig:component_url_input
						label="URL"
						name="demo_url"
						id="demo-url"
						placeholder="www.tailadmin.com"
					/>

					<!-- URL Input: prefijo https -->
					<twig:component_url_input
						label="Secure URL"
						name="demo_url_https"
						id="demo-url-https"
						prefix="https://"
						placeholder="www.example.com"
						help="Usa HTTPS para enlaces seguros."
					/>

					<!-- URL Input: requerido con error -->
					<twig:component_url_input
						label="Website URL"
						name="demo_url_required"
						id="demo-url-required"
						placeholder="www.example.com"
						:required="true"
						error="Introduce una URL válida."
					/>

					<!-- Elements -->
					<div id="copy-input">
						<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
							Website
						</label>
						<div class="relative">
							<button id="copy-button" class="absolute top-1/2 right-0 inline-flex -translate-y-1/2 cursor-pointer items-center gap-1 border-l border-gray-200 py-3 pr-3 pl-3.5 text-sm font-medium text-gray-700 dark:border-gray-800 dark:text-gray-400">
								{{ ux_icon('heroicons:document-duplicate', { class: 'w-5 h-5' }) }}
								<div id="copy-text">Copy</div>
							</button>
							<input value="www.tailadmin.com" type="url" id="website-input" class="dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent py-3 pr-[90px] pl-4 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"/>
						</div>
					</div>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						File Input
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- File Input: estado por defecto -->
					<twig:component_file_input
						label="Upload file"
						name="demo_file"
						id="demo-file"
					/>

					<!-- File Input: accept + required + error -->
					<twig:component_file_input
						label="Upload image"
						name="demo_file_image"
						id="demo-file-image"
						accept="image/png,image/jpeg,image/webp"
						:required="true"
						error="Debes seleccionar una imagen válida."
						help="Formatos permitidos: PNG, JPEG y WebP."
					/>

					<!-- File Input: multiple + disabled -->
					<twig:component_file_input
						label="Upload files"
						name="demo_file_multiple"
						id="demo-file-multiple"
						:multiple="true"
						:disabled="true"
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Checkboxes
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<div class="flex flex-wrap items-center gap-8">
						<!-- Checkbox: estado por defecto -->
						<twig:component_checkbox
							label="Default"
							name="demo_checkbox_default"
							id="demo-checkbox-default"
						/>

						<!-- Checkbox: marcado -->
						<twig:component_checkbox
							label="Checked"
							name="demo_checkbox_checked"
							id="demo-checkbox-checked"
							:checked="true"
						/>

						<!-- Checkbox: disabled -->
						<twig:component_checkbox
							label="Disabled"
							name="demo_checkbox_disabled"
							id="demo-checkbox-disabled"
							:checked="true"
							:disabled="true"
						/>
					</div>

					<!-- Checkbox: required + error -->
					<twig:component_checkbox
						label="Accept terms and conditions"
						name="demo_checkbox_required"
						id="demo-checkbox-required"
						:required="true"
						error="Debes aceptar los términos para continuar."
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Radio Buttons
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<div class="flex flex-wrap items-center gap-8">
						<!-- Radio: estado por defecto -->
						<twig:component_radio
							label="Default"
							name="demo_radio"
							id="demo-radio-default"
							value="default"
						/>

						<!-- Radio: seleccionado -->
						<twig:component_radio
							label="Secondary"
							name="demo_radio"
							id="demo-radio-secondary"
							value="secondary"
							:checked="true"
						/>

						<!-- Radio: disabled -->
						<twig:component_radio
							label="Disabled Secondary"
							name="demo_radio_disabled"
							id="demo-radio-disabled"
							value="disabled"
							:disabled="true"
						/>
					</div>

					<!-- Radio: required + error -->
					<twig:component_radio
						label="Required option"
						name="demo_radio_required"
						id="demo-radio-required"
						value="required"
						:required="true"
						error="Debes seleccionar una opción."
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Toggle switch input
					</h3>
				</div>
				<div
					class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<div class="mb-6 flex flex-wrap items-center gap-6 sm:gap-8">
						<!-- Toggle switch brand: default -->
						<twig:component_toggle_switch
							label="Default"
							name="demo_toggle_brand_default"
							id="demo-toggle-brand-default"
							variant="brand"
						/>

						<!-- Toggle switch brand: checked -->
						<twig:component_toggle_switch
							label="Checked"
							name="demo_toggle_brand_checked"
							id="demo-toggle-brand-checked"
							variant="brand"
							:checked="true"
						/>

						<!-- Toggle switch brand: disabled -->
						<twig:component_toggle_switch
							label="Disabled"
							name="demo_toggle_brand_disabled"
							id="demo-toggle-brand-disabled"
							variant="brand"
							:disabled="true"
						/>
					</div>

					<div class="flex flex-wrap items-center gap-6 sm:gap-8">
						<!-- Toggle switch dark: default -->
						<twig:component_toggle_switch
							label="Default"
							name="demo_toggle_dark_default"
							id="demo-toggle-dark-default"
							variant="dark"
						/>

						<!-- Toggle switch dark: checked -->
						<twig:component_toggle_switch
							label="Checked"
							name="demo_toggle_dark_checked"
							id="demo-toggle-dark-checked"
							variant="dark"
							:checked="true"
						/>

						<!-- Toggle switch dark: disabled -->
						<twig:component_toggle_switch
							label="Disabled"
							name="demo_toggle_dark_disabled"
							id="demo-toggle-dark-disabled"
							variant="dark"
							:disabled="true"
						/>
					</div>

					<!-- Toggle switch: required + error -->
					<twig:component_toggle_switch
						label="Enable notifications"
						name="demo_toggle_required"
						id="demo-toggle-required"
						variant="brand"
						:required="true"
						error="Debes activar esta opción."
					/>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
				<div class="px-5 py-4 sm:px-6 sm:py-5">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Dropzone
					</h3>
				</div>
				<div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
					<!-- Dropzone: estado por defecto -->
					<twig:component_dropzone
						name="demo_dropzone"
						id="demo-dropzone"
						title="Drop File Here"
						description="Drag and drop your files here or browse"
					/>

					<!-- Dropzone: restricción de tipos -->
					<twig:component_dropzone
						label="Upload image"
						name="demo_dropzone_images"
						id="demo-dropzone-images"
						title="Drop Image Here"
						description="Drag and drop your PNG, JPG, WebP or SVG images here or browse"
						accept="image/png,image/jpeg,image/webp,image/svg+xml"
						acceptErrorMessage="Solo se permiten imágenes PNG, JPG, WebP o SVG."
						help="Formatos permitidos: PNG, JPG, WebP y SVG."
					/>

					<!-- Dropzone: archivo requerido -->
					<twig:component_dropzone
						label="Required file"
						name="demo_dropzone_required"
						id="demo-dropzone-required"
						title="Drop Required File Here"
						description="Debes seleccionar un archivo para continuar"
						:required="true"
						error="Debes adjuntar un archivo."
					/>

					<!-- Dropzone: límite de peso -->
					<twig:component_dropzone
						label="Upload with size limit"
						name="demo_dropzone_size"
						id="demo-dropzone-size"
						title="Drop File Here"
						description="El archivo no debe superar 1 MB"
						:maxFileSizeKb="1024"
						maxFileSizeErrorMessage="El archivo supera el tamaño máximo permitido de 1 MB."
						help="Tamaño máximo permitido: 1 MB."
					/>
				</div>
			</div>
		</div>
	</div>
	<!-- ====== Form Elements Section End -->
{% endblock %}
