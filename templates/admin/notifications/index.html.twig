{% extends '@admin/base.html.twig' %}

{% block page_title %}
	Notificaciones
{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Notificaciones</li>
{% endblock %}

{% block title %}Notificaciones{% endblock %}

{% block page_actions %}
	{% if unread_count > 0 %}
		<form method="post" action="{{ path('app_backend_notifications_read_all') }}">
			<input type="hidden" name="_token" value="{{ csrf_token('notification_mark_all') }}">
			<button type="submit" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.03]">
				{{ ux_icon('heroicons:check', { class: 'w-5 h-5' }) }}
				Marcar todas como leídas
			</button>
		</form>
	{% endif %}
{% endblock %}

{% block body %}
	<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]" data-controller="admin-paginator">
		<div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800 sm:px-6">
			<h3 class="text-base font-medium text-gray-800 dark:text-white/90">Bandeja</h3>
		</div>

		<ul class="divide-y divide-gray-100 dark:divide-gray-800">
			{% for notification in entities %}
				<li>
					<form method="post" action="{{ path('app_backend_notification_open', { id: notification.id }) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('notification_open') }}">
						<button
							type="submit"
							class="flex w-full cursor-pointer gap-4 border-0 bg-transparent px-5 py-4 text-left transition hover:bg-gray-50 dark:hover:bg-white/[0.03] sm:px-6"
						>
						<span class="relative z-1 block h-10 w-10 shrink-0">
							{% if notification.readAt is null %}
								<span class="absolute top-0 right-0 z-10 h-2.5 w-2.5 rounded-full bg-orange-400 ring-2 ring-white dark:ring-gray-900" aria-hidden="true"></span>
							{% endif %}
							{% if notification.actor %}
								{% include '@admin/partials/_user_profile_avatar.html.twig' with {
									user: notification.actor,
									size_class: 'h-10 w-10',
									icon_class: 'h-10 w-10 text-gray-400 dark:text-gray-500',
									width: 40,
									height: 40,
								} %}
							{% else %}
								<span class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-gray-100 text-gray-500 dark:border-gray-800 dark:bg-gray-800 dark:text-gray-400">
									{{ ux_icon('heroicons:bell', { class: 'h-5 w-5' }) }}
								</span>
							{% endif %}
						</span>

						<span class="min-w-0 flex-1">
							<span class="flex flex-wrap items-center gap-2">
								<span class="font-medium text-gray-800 dark:text-white/90">{{ notification.title }}</span>
								{% if notification.readAt is null %}
									<span class="inline-flex rounded-full bg-orange-50 px-2 py-0.5 text-xs font-medium text-orange-700 dark:bg-orange-500/15 dark:text-orange-400">No leída</span>
								{% endif %}
							</span>
							<span class="mt-1 block text-sm text-gray-500 dark:text-gray-400">{{ notification.message }}</span>
							<span class="mt-2 flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
								<span>{{ notification.type.label }}</span>
								<span class="h-1 w-1 rounded-full bg-gray-400"></span>
								<time datetime="{{ notification.createdAt|date('c') }}">{{ notification.createdAt|app_datetime }}</time>
							</span>
						</span>
						</button>
					</form>
				</li>
			{% else %}
				<li class="px-5 py-10 text-center text-sm text-gray-500 dark:text-gray-400 sm:px-6">
					No tienes notificaciones.
				</li>
			{% endfor %}
		</ul>

		<div class="px-5 pb-5 sm:px-6">
			{% include '@admin/partials/paginator/_paginator.html.twig' %}
		</div>
	</div>
{% endblock %}
