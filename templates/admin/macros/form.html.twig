{% macro field_error(field) -%}
	{%- if field.vars.errors|length > 0 -%}
		{{- field.vars.errors[0].message -}}
	{%- endif -%}
{%- endmacro %}

{% macro field_errors(field, separator = ' ') -%}
	{%- set messages = [] -%}
	{%- for error in field.vars.errors -%}
		{%- set messages = messages|merge([error.message]) -%}
	{%- endfor -%}
	{{- messages|join(separator) -}}
{%- endmacro %}
