{% from '@admin/macros/form.html.twig' import field_error %}

<div data-user-profile-target="profilePasswordModal" class="fixed inset-0 z-99999 hidden items-center justify-center overflow-y-auto p-5">
	<div data-action="click->user-profile#togglePasswordModal" class="modal-close-btn fixed inset-0 h-full w-full bg-gray-400/50 backdrop-blur-[32px]"></div>
	<div class="no-scrollbar relative w-full max-w-[700px] overflow-y-auto rounded-3xl bg-white p-4 dark:bg-gray-900 lg:p-11">
		<button
			type="button"
			data-action="click->user-profile#togglePasswordModal"
			class="transition-color absolute right-5 top-5 z-999 flex h-11 w-11 items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-gray-200 hover:text-gray-600 dark:bg-gray-700 dark:bg-white/[0.05] dark:text-gray-400 dark:hover:bg-white/[0.07] dark:hover:text-gray-300"
		>
			{{ ux_icon('heroicons:x-mark', { class: 'w-6 h-6' }) }}
		</button>

		<div class="px-2 pr-14">
			<h4 class="mb-2 text-2xl font-semibold text-gray-800 dark:text-white/90">
				Cambiar contraseña
			</h4>
			<p class="mb-6 text-sm text-gray-500 dark:text-gray-400 lg:mb-7">
				Ingresa tu contraseña actual y define una nueva contraseña segura.
			</p>
		</div>

		{{ form_start(password_form, {
			action: path('app_backend_user_profile'),
			attr: { class: 'flex flex-col' },
			render_rest: false,
		}) }}
			<div class="px-2">
				<div class="grid grid-cols-1 gap-x-6 gap-y-5">
					<twig:component_password_input
						label="Contraseña actual"
						name="{{ password_form.currentPassword.vars.full_name }}"
						id="profile-current-password"
						placeholder="Ingresa tu contraseña actual"
						autocomplete="current-password"
						:required="true"
						error="{{ field_error(password_form.currentPassword) }}"
					/>

					<twig:component_password_input
						label="Nueva contraseña"
						name="{{ password_form.plainPassword.vars.full_name }}"
						id="profile-plain-password"
						placeholder="Ingresa la nueva contraseña"
						autocomplete="new-password"
						:required="true"
						error="{{ field_error(password_form.plainPassword) }}"
						help="Mínimo 5 caracteres, con letras y números."
					/>

					<twig:component_password_input
						label="Confirmar contraseña"
						name="{{ password_form.confirmPassword.vars.full_name }}"
						id="profile-confirm-password"
						placeholder="Confirma la nueva contraseña"
						autocomplete="new-password"
						:required="true"
						error="{{ field_error(password_form.confirmPassword) }}"
					/>
				</div>
			</div>

			<div class="mt-6 flex items-center gap-3 px-2 lg:justify-end">
				<button
					type="button"
					data-action="click->user-profile#togglePasswordModal"
					class="flex w-full justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] sm:w-auto"
				>
					Cerrar
				</button>
				<button
					type="submit"
					class="flex w-full justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-brand-600 sm:w-auto"
				>
					Guardar cambios
				</button>
			</div>

			{{ form_widget(password_form._token) }}
		{{ form_end(password_form, { render_rest: false }) }}
	</div>
</div>
