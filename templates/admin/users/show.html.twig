{% extends '@admin/base.html.twig' %}

{% block title %}Usuario {{ user.nickname }}{% endblock %}

{% block page_title %}
	Usuario
{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_users') }}">
			Usuarios
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">{{ user.nickname }}</li>
{% endblock %}

{% block body %}
	<div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] lg:p-6">
		<h3 class="mb-5 text-lg font-semibold text-gray-800 dark:text-white/90 lg:mb-7">
			Ficha de usuario
		</h3>

		<div class="mb-6 rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
			<div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
				<div class="flex w-full flex-col items-center gap-6 xl:flex-row">
					{% include '@admin/partials/_user_profile_avatar.html.twig' with { user: user } %}
					<div class="order-3 xl:order-2">
						<h4 class="mb-2 text-center text-lg font-semibold text-gray-800 dark:text-white/90 xl:text-left">
							{{ user.name }} {{ user.lastname }}
						</h4>
						<div class="flex flex-col items-center gap-1 text-center xl:flex-row xl:gap-3 xl:text-left">
							{% set primaryRole = user.primaryApplicationRole %}
							{% if primaryRole %}
								<p class="text-sm text-gray-500 dark:text-gray-400">
									{{ primaryRole.label }}
								</p>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="mb-6 rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
			<h4 class="text-lg font-semibold text-gray-800 dark:text-white/90 lg:mb-6">
				Información general
			</h4>

			<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-7 2xl:gap-x-32">
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Nombre</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.name }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Apellido</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.lastname }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Email</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.email ?? '—' }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Nickname</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.nickname }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Teléfono</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.formattedPhone ?? '—' }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Roles</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">
						{{ user.applicationRoles|map(role => role.label)|join(', ') }}
					</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Estado</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.status.label }}</p>
				</div>
				<div>
					<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Fecha de creación</p>
					<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.createdAt|date('d/m/Y H:i') }}</p>
				</div>
			</div>
		</div>

		{% if effective_is_granted('ROLE_DEVELOPER') %}
			<div class="mb-6 rounded-2xl border border-gray-200 p-5 dark:border-gray-800 lg:p-6">
				<h4 class="text-lg font-semibold text-gray-800 dark:text-white/90 lg:mb-6">
					Información de sesión
				</h4>

				<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-7 2xl:gap-x-32">
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Último login</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">
							{{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y H:i') : '—' }}
						</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">IP del último login</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.lastLoginIp ?? '—' }}</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Último intento fallido</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">
							{{ user.lastFailedLoginAt ? user.lastFailedLoginAt|date('d/m/Y H:i') : '—' }}
						</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Intentos fallidos</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.failedLoginAttempts }}</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Bloqueo de inicio de sesión</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">
							{% if user.loginTemporarilyBlocked and user.noLoginUntil %}
								{{ user.noLoginUntil|date('d/m/Y H:i') }}
							{% else %}
								No
							{% endif %}
						</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Última edición de datos</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.lastUpdatedAt|date('d/m/Y H:i') }}</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Última actualización de contraseña</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.passwordUpdatedAt|date('d/m/Y H:i') }}</p>
					</div>
					<div>
						<p class="mb-2 text-xs leading-normal text-gray-500 dark:text-gray-400">Usuario oculto</p>
						<p class="text-sm font-medium text-gray-800 dark:text-white/90">{{ user.isHidden ? 'Sí' : 'No' }}</p>
					</div>
				</div>
			</div>
		{% endif %}

		<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
			<a href="{{ path('app_backend_users') }}"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 hover:text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-gray-200">
				{{ ux_icon('heroicons:arrow-left', { class: 'w-5 h-5' }) }}
				Volver al listado
			</a>
			{% if can_edit %}
				<a href="{{ path('app_backend_user_edit', { id: user.id }) }}"
					class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-4 py-3 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600">
					{{ ux_icon('heroicons:pencil-square', { class: 'w-5 h-5' }) }}
					Editar
				</a>
			{% endif %}
		</div>
	</div>
{% endblock %}
