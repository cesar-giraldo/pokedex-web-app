{% extends '@admin/base.html.twig' %}

{% from '@admin/macros/grid.html.twig' import sortable_link as sortLink %}

{% block page_title %}
	Usuarios
{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Usuarios</li>
{% endblock %}

{% block title %}Listado de Usuarios{% endblock %}

{% block page_actions %}
	<a href="{{ path('app_backend_user_new') }}" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600">
		{{ ux_icon('heroicons:plus', { class: 'w-5 h-5' }) }}
		Nuevo Usuario
	</a>
{% endblock %}

{% block body %}
	<div class="space-y-5 sm:space-y-6">
		<div data-controller="admin-paginator"
			data-admin-paginator-entity-value="{{ active_page|default('admin_list') }}"
			class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
			<div class="px-5 py-4 sm:px-6 sm:py-5 flex flex-col gap-4 lg:flex-row lg:justify-between lg:items-center">
				<div class="w-full lg:w-auto">
					<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
						Listado de Usuarios
					</h3>
				</div>

				<div class="w-full max-w-md lg:max-w-md lg:mb-0 shrink">
					{{ form_start(search_form, {'attr': {'class': 'w-full'}}) }}
					<div class="flex gap-2 w-full items-center">
						<div class="grow min-w-0">
							{{ form_row(search_form.q, {'attr': {'class': 'dark:bg-dark-900 shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-200 bg-transparent py-2.5 px-3 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-800 dark:bg-gray-900 dark:bg-white/[0.03] dark:text-white/90 dark:placeholder:text-white/30'}}) }}
						</div>
						<div class="relative group/tooltip">
							<button type="submit" class="inline-flex items-center justify-center gap-2 px-3 py-3 md:px-4 text-sm font-medium text-white transition rounded-lg bg-brand-500 shadow-theme-xs hover:bg-brand-600 shrink-0"
									title="Buscar">
								{{ ux_icon('heroicons:magnifying-glass', { class: 'w-6 h-6 block md:hidden' }) }}
								<span class="hidden md:block">Buscar</span>
							</button>
							<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tooltip:block z-50 pointer-events-none">
								<div class="bg-gray-900 text-white dark:bg-white dark:text-gray-900 text-xs rounded-md py-1.5 px-2.5 shadow-md whitespace-nowrap font-medium">
									Buscar
									<div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-white"></div>
								</div>
							</div>
						</div>
						<div class="relative group/tooltip">
							<button type="button" data-admin-paginator-target="resetButton"
									class="hidden items-center justify-center gap-2 rounded-lg bg-white px-4 py-3 text-sm font-medium text-gray-700 shadow-theme-xs ring-1 ring-gray-300 transition hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-700 dark:hover:bg-white/3"
									data-action="click->admin-paginator#resetPreferences"
									title="Restablecer tabla">
								{{ ux_icon('heroicons:arrow-path', { class: 'w-6 h-6' }) }}
							</button>
							<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tooltip:block z-50 pointer-events-none">
								<div class="bg-gray-900 text-white dark:bg-white dark:text-gray-900 text-xs rounded-md py-1.5 px-2.5 shadow-md whitespace-nowrap font-medium">
									Restablecer Tabla
									<div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-white"></div>
								</div>
							</div>
						</div>
					</div>
					{{ form_end(search_form) }}
				</div>
			</div>
			<div class="p-5 border-t border-gray-100 dark:border-gray-800 sm:p-6">
				<div class="overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
					<div class="max-w-full overflow-x-auto">
						<table class="min-w-full">
							<thead>
								<tr class="border-b border-gray-100 dark:border-gray-800">
									<th class="px-5 py-3 sm:px-6">
										{{ sortLink('u.name', 'Nombre', current_sort, current_direction) }}
									</th>
									<th class="px-5 py-3 sm:px-6">
										{{ sortLink('u.nickname', 'Nickname', current_sort, current_direction) }}
									</th>
									<th class="px-5 py-3 sm:px-6">
										{{ sortLink('u.email', 'Email', current_sort, current_direction) }}
									</th>
									<th class="px-5 py-3 sm:px-6">
										<div class="flex items-center">
											<p class="font-medium text-gray-500 text-theme-sm dark:text-gray-400">
												Teléfono
											</p>
										</div>
									</th>
									<th class="px-5 py-3 sm:px-6">
										<div class="flex items-center">
											<p class="font-medium text-gray-500 text-theme-sm dark:text-gray-400">
												Rol
											</p>
										</div>
									</th>
									<th class="px-5 py-3 sm:px-6">
										{{ sortLink('u.status', 'Estado', current_sort, current_direction) }}
									</th>
									<th class="px-5 py-3 sm:px-6">
										{{ sortLink('u.createdAt', 'Registro', current_sort, current_direction) }}
									</th>
									<th class="px-5 py-3 sm:px-6">
										<div class="flex items-center">
											<p class="font-medium text-gray-500 text-theme-sm dark:text-gray-400">
												Acciones
											</p>
										</div>
									</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100 dark:divide-gray-800">
								{% for user in entities %}
									<tr>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center gap-3">
												{% include '@admin/partials/_user_profile_avatar.html.twig' with {
													user: user,
													size_class: 'h-10 w-10',
													icon_class: 'h-10 w-10 text-gray-400 dark:text-gray-500',
												} %}
												<p class="font-medium text-gray-800 text-theme-sm dark:text-white/90">
													{{ user.name }} {{ user.lastname }}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{{ user.nickname }}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{% if user.email %}
														{{ user.email }}
													{% else %}
														—
													{% endif %}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{% if user.countryCode and user.cellphone %}
														+{{ user.countryCode }} {{ user.cellphone }}
													{% else %}
														—
													{% endif %}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{{ user.applicationRoles|map(role => role.label)|join(', ') }}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{{ user.status.label }}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													{{ user.createdAt|date('d/m/Y H:i') }}
												</p>
											</div>
										</td>
										<td class="px-5 py-4 sm:px-6">
											<div class="flex items-center gap-1">
												<a href="{{ path('app_backend_user_show', { id: user.id }) }}"
													class="inline-flex items-center justify-center rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-brand-500 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-brand-400"
													title="Ver {{ user.nickname }}">
													{{ ux_icon('heroicons:eye', { class: 'w-5 h-5' }) }}
												</a>
												{% if user.id in editable_user_ids %}
													<a href="{{ path('app_backend_user_edit', { id: user.id }) }}"
														class="inline-flex items-center justify-center rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-brand-500 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-brand-400"
														title="Editar {{ user.nickname }}">
														{{ ux_icon('heroicons:pencil-square', { class: 'w-5 h-5' }) }}
													</a>
												{% endif %}
												{% if user.id in impersonatable_user_ids %}
													<a href="{{ path('app_backend_home', {'_switch_user': user.nickname}) }}"
														class="inline-flex items-center justify-center rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-brand-500 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-brand-400"
														title="Impersonar este Usuario" data-turbo-prefetch="false">
														{{ ux_icon('heroicons:identification', { class: 'w-5 h-5' }) }}
													</a>
												{% endif %}
											</div>
										</td>
									</tr>
								{% else %}
									<tr>
										<td class="px-5 py-4 sm:px-6" colspan="8">
											<div class="flex items-center justify-center">
												<p class="text-gray-500 text-theme-sm dark:text-gray-400">
													No se encontraron usuarios.
												</p>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{% include('@admin/partials/paginator/_paginator.html.twig') %}
			</div>
		</div>
	</div>
{% endblock %}
