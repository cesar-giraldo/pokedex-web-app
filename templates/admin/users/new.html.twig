{% extends '@admin/base.html.twig' %}

{% block title %}Nuevo Usuario{% endblock %}

{% block page_title %}
	Usuarios
{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_users') }}">
			Usuarios
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Nuevo</li>
{% endblock %}

{% block body %}
	<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
		<div class="px-5 py-4 sm:px-6 sm:py-5 border-b border-gray-100 dark:border-gray-800">
			<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
				Crear usuario
			</h3>
		</div>

		{{ form_start(form, { attr: { class: 'space-y-0' }, render_rest: false }) }}
		{% include '@admin/users/_form.html.twig' %}

		<div class="flex flex-col gap-4 border-t border-gray-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-6 dark:border-gray-800">
			<div class="flex flex-wrap items-center gap-3">
				<a href="{{ path('app_backend_users') }}" class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-medium text-gray-700 shadow-theme-xs ring-1 ring-inset ring-gray-300 transition hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-700 dark:hover:bg-white/[0.03]">
					Cancelar
				</a>
				<button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-5 py-3 text-sm font-medium text-white shadow-theme-xs transition hover:bg-brand-600">
					Crear Usuario
				</button>
			</div>
		</div>

		{{ form_widget(form._token) }}
		{{ form_end(form, { render_rest: false }) }}
	</div>
{% endblock %}
