<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"
    />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>{% block title %}Welcome {% endblock %} | Pokedex</title>
    
    <!-- ===== Title Icon ===== -->
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo/logo-icon.svg', 'admin') }}">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
    <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
  </head>
  <body
    data-controller="template-base" 
    data-template-base-selected-menu-value="{{ active_menu|default('dashboard') }}"
    data-template-base-page-value="{{active_page|default('Pokedex')}}"
    data-template-base-dark-class="dark"
    data-template-base-hide-class="hidden"
    data-template-base-target="bodyContainer"
    class="group dark:bg-gray-900"
  >
    <!-- ===== Preloader Start ===== -->
    {{ include('@admin/partials/_preloader.html.twig') }}
    <!-- ===== Preloader End ===== -->

    <!-- ===== Page Wrapper Start ===== -->
    <div class="flex h-screen overflow-hidden">
      <!-- ===== Sidebar Start ===== -->
      {{ include('@admin/partials/_sidebar.html.twig') }}
      <!-- ===== Sidebar End ===== -->

      <!-- ===== Content Area Start ===== -->
      <div
        class="relative flex flex-1 flex-col overflow-x-hidden overflow-y-auto"
      >
        <!-- Small Device Overlay Start -->
        {{ include('@admin/partials/_overlay.html.twig') }}
        <!-- Small Device Overlay End -->

        <!-- ===== Header Start ===== -->
        {{ include('@admin/partials/_header.html.twig') }}
        <!-- ===== Header End ===== -->

        <!-- ===== Main Content Start ===== -->
        <main>
          <div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
            <!-- Breadcrumb Start -->
            <div class="{% if active_page == 'dashboard' %}hidden{% endif %}">
              {# <p>Page Name: <span data-template-base-target="outputPageName"></span></p> #}
              <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-col gap-1">
                  <h2 class="text-xl font-semibold text-gray-800 dark:text-white/90">
                    {% block page_title %}
                      {{ active_page|title }}
                    {% endblock %}
                  </h2>

                  <nav>
                    <ol class="flex items-center gap-1.5">
                      <li>
                        <a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_home')}}">
                          Home
                          {{ ux_icon('heroicons:chevron-right', {
                              class: 'w-4 h-4'
                          }) }}
                        </a>
                      </li>
                      {% block breadcrumb %}
                      {% endblock %}
                    </ol>
                  </nav>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {% block page_actions %}{% endblock %}
                </div>
              </div>
            </div>
            <!-- Breadcrumb End -->

            {{ include('@admin/partials/alert/_general_notifications.html.twig') }}

            {% block body %}{% endblock %}
            
          </div>
        </main>
        <!-- ===== Main Content End ===== -->
      </div>
      <!-- ===== Content Area End ===== -->
    </div>
    <!-- ===== Page Wrapper End ===== -->
  </body>
</html>

