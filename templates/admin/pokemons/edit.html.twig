{% extends '@admin/base.html.twig' %}

{% block title %}Editar {{ pokemon.name }}{% endblock %}

{% block page_title %}
	Editar Pokémon
{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_pokemons') }}">
			Pokemons
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li>
		<span class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
			{{ pokemon.name }}
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</span>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Editar</li>
{% endblock %}

{% block body %}
	{% set is_basic = edit_tab == 'basic' %}
	{% set tab_base = 'inline-flex items-center border-b-2 px-4 pt-2 pb-3 text-sm font-medium transition' %}
	{% set tab_active = 'border-brand-500 text-brand-500' %}
	{% set tab_inactive = 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200' %}

	<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
		<div class="px-5 pt-4 sm:px-6 sm:pt-5 border-b border-gray-100 dark:border-gray-800">
			

			<nav class="flex flex-wrap gap-1 dark:border-gray-800" aria-label="Secciones de edición">
				<a
					href="{{ path('app_backend_pokemon_edit_basic', { id: pokemon.id }) }}"
					class="{{ tab_base }} {{ is_basic ? tab_active : tab_inactive }}"
					{% if is_basic %}aria-current="page"{% endif %}
				>
					Información Básica
				</a>
				<a
					href="{{ path('app_backend_pokemon_edit_multimedia', { id: pokemon.id }) }}"
					class="{{ tab_base }} {{ not is_basic ? tab_active : tab_inactive }}"
					{% if not is_basic %}aria-current="page"{% endif %}
				>
					Multimedia
				</a>
			</nav>
		</div>

		

		{% if is_basic %}
			{% include '@admin/pokemons/_edit_basic.html.twig' %}
		{% else %}
			{% include '@admin/pokemons/_edit_multimedia.html.twig' %}
		{% endif %}
	</div>
{% endblock %}
