<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: 10px;
            color: #111827;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 24px 8px;
            border-bottom: 2px solid #6366f1;
            box-sizing: border-box;
        }

        .header h1 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
        }

        .header span {
            color: #6b7280;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Listado de Pokémon</h1>
        <span>{{ generated_at|date('d/m/Y H:i') }}</span>
    </div>
</body>
</html>
