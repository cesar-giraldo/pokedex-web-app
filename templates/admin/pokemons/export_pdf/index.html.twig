<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Listado de Pokémon</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: 11px;
            color: #1f2937;
            background: #ffffff;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #6366f1;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #111827;
        }

        .header p {
            margin: 4px 0 0;
            color: #6b7280;
        }

        .meta {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 18px;
        }

        .meta-card {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 10px 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #f9fafb;
        }

        .meta-card span {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #6b7280;
        }

        .meta-card strong {
            font-size: 13px;
            color: #111827;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .page-section {
            page-break-inside: avoid;
        }

        .card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            page-break-inside: avoid;
        }

        .sprite {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 9999px;
            background: #f3f4f6;
            flex-shrink: 0;
        }

        .sprite img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        .card-body {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .card-title h2 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: #111827;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 9999px;
            font-size: 10px;
            font-weight: 600;
            background: #eef2ff;
            color: #4338ca;
        }

        .stats {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .stat {
            display: flex;
            flex-direction: column;
            min-width: 52px;
        }

        .stat span {
            font-size: 9px;
            color: #6b7280;
            text-transform: uppercase;
        }

        .stat strong {
            font-size: 12px;
            color: #111827;
        }

        .status-visible {
            color: #047857;
        }

        .status-hidden {
            color: #b45309;
        }

        .empty-state {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 120px;
            border: 1px dashed #d1d5db;
            border-radius: 10px;
            color: #6b7280;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
            color: #9ca3af;
            font-size: 10px;
        }
    </style>
</head>
<body>
    {% if not repeat_header_footer %}
    <header class="header">
        <div>
            <h1>Listado de Pokémon</h1>
            <p>Exportación generada desde el panel administrativo</p>
        </div>
        <div>
            <p>{{ generated_at|date('d/m/Y H:i') }}</p>
        </div>
    </header>
    {% endif %}

    <section class="meta page-section">
        <div class="meta-card">
            <span>Total registros</span>
            <strong>{{ total_results }}</strong>
        </div>
        <div class="meta-card">
            <span>Página</span>
            <strong>{{ current_page }} de {{ total_pages }}</strong>
        </div>
        <div class="meta-card">
            <span>Búsqueda</span>
            <strong>{{ search_term ?: 'Sin filtro' }}</strong>
        </div>
        <div class="meta-card">
            <span>Orden</span>
            <strong>{{ current_sort }} ({{ current_direction|upper }})</strong>
        </div>
    </section>

    {% if pokemons is empty %}
        <div class="empty-state">
            No se encontraron pokémones para exportar.
        </div>
    {% else %}
        <section class="cards">
            {% for pokemon in pokemons %}
                {% set sprite = pokemon.spriteFront ?: pokemon.spriteBack %}
                {% if sprite and (sprite starts with 'http://' or sprite starts with 'https://') %}
                    {% set spriteUrl = sprite %}
                {% elseif sprite %}
                    {% set spriteUrl = absolute_url(sprite) %}
                {% else %}
                    {% set spriteUrl = absolute_url(asset('images/pokemon/pokeball.png', 'shared')) %}
                {% endif %}

                <article class="card">
                    <div class="sprite">
                        <img src="{{ spriteUrl }}" alt="Sprite de {{ pokemon.name }}">
                    </div>
                    <div class="card-body">
                        <div class="card-title">
                            <h2>{{ pokemon.name }}</h2>
                            <span class="badge">{{ pokemon.type.name }}</span>
                        </div>
                        <div class="stats">
                            <div class="stat">
                                <span>Speed</span>
                                <strong>{{ pokemon.speed ?? '—' }}</strong>
                            </div>
                            <div class="stat">
                                <span>Attack</span>
                                <strong>{{ pokemon.attack ?? '—' }}</strong>
                            </div>
                            <div class="stat">
                                <span>Defense</span>
                                <strong>{{ pokemon.defense ?? '—' }}</strong>
                            </div>
                            <div class="stat">
                                <span>HP</span>
                                <strong>{{ pokemon.healthPoints ?? '—' }}</strong>
                            </div>
                            <div class="stat">
                                <span>Estado</span>
                                <strong class="{{ pokemon.isHidden ? 'status-hidden' : 'status-visible' }}">
                                    {{ pokemon.isHidden ? 'Oculto' : 'Visible' }}
                                </strong>
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}

    {% if not repeat_header_footer %}
    <footer class="footer">
        <span>Pokédex Admin</span>
        <span>Listado página {{ current_page }} de {{ total_pages }}</span>
    </footer>
    {% endif %}
</body>
</html>
