<div
	id="pokemon-image-edit-modal"
	hidden
	data-component-sortable-gallery-target="editModal"
	data-action="keydown.esc@window->component-sortable-gallery#closeEditModal"
	class="fixed inset-0 z-99999 hidden items-center justify-center overflow-y-auto p-5"
	role="dialog"
	aria-modal="true"
	aria-labelledby="pokemon-image-edit-modal-title"
	aria-hidden="true"
>
	<div
		data-action="click->component-sortable-gallery#closeEditModal"
		class="fixed inset-0 h-full w-full bg-gray-400/50 backdrop-blur-[32px]"
	></div>

	<div class="relative w-full max-w-lg rounded-3xl bg-white p-6 dark:bg-gray-900 lg:p-8">
		<h4 id="pokemon-image-edit-modal-title" class="mb-2 text-xl font-semibold text-gray-800 dark:text-white/90">
			Editar descripción
		</h4>
		<p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
			Actualiza el texto de la imagen. Puedes dejarlo vacío para quitar la descripción.
		</p>

		<form
			data-action="submit->component-sortable-gallery#submitEdit"
			data-turbo="false"
			class="space-y-6"
		>
			<div data-component-sortable-gallery-target="editDescriptionField">
				<twig:component_text_input
					label="Descripción"
					name="pokemon_image_description"
					id="pokemon-image-edit-description"
					placeholder="Descripción opcional de la imagen"
					:maxLength="form_field_max_length(form.description)"
					autocomplete="off"
					help="Opcional. Máximo 255 caracteres."
				/>
			</div>

			<p
				data-component-sortable-gallery-target="editError"
				class="text-theme-xs text-error-500 hidden"
				role="alert"
			></p>

			<div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
				<button
					type="button"
					data-action="click->component-sortable-gallery#closeEditModal"
					class="flex w-full justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] sm:w-auto"
				>
					Cancelar
				</button>
				<button
					type="submit"
					data-component-sortable-gallery-target="editSubmit"
					class="flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-brand-500 sm:w-auto"
				>
					Guardar cambios
				</button>
			</div>
		</form>
	</div>
</div>
