<div
	class="flex flex-wrap gap-4 sm:items-center sm:justify-center">
	<!-- Primary Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-brand-500 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white">
		Primary
		{{ ux_icon('heroicons:plus-circle', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Success Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-success-500 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white">
		Success
		{{ ux_icon('heroicons:check-circle', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Error Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-error-500 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white">
		Error
		{{ ux_icon('heroicons:x-mark', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Warning Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-warning-500 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white">
		Warning
		{{ ux_icon('heroicons:exclamation-triangle', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Info Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-blue-light-500 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white">
		Info
		{{ ux_icon('heroicons:information-circle', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Light Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-gray-400 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white dark:bg-white/5 dark:text-white/80">
		Light
		{{ ux_icon('heroicons:plus-circle', { class: 'w-5 h-5 fill-current' }) }}
	</span>

	<!-- Dark Badge-->
	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-gray-800 py-0.5 pl-2.5 pr-2 text-sm font-medium text-white dark:bg-white/15 dark:text-white">
		Dark
		{{ ux_icon('heroicons:plus-circle', { class: 'w-5 h-5 fill-current' }) }}
	</span>
</div>
