<aside class="sidebar fixed left-0 top-0 z-9999 flex h-screen w-[290px] flex-col 
	overflow-y-hidden border-r border-gray-200 bg-white px-5 dark:border-gray-800
    dark:bg-black lg:static lg:translate-x-0
	group-data-[sidebar=collapsed]:translate-x-0
	group-data-[sidebar=collapsed]:lg:w-[90px]
	group-data-[sidebar=expanded]:max-lg:-translate-x-full">
	<!-- SIDEBAR HEADER -->
	<div class="flex items-center gap-2 pt-8 sidebar-header pb-7
		group-data-[sidebar=collapsed]:justify-center
		group-data-[sidebar=expanded]:justify-between">
		<a href="{{ path('app_design_index')}}">
			<span class="logo group-data-[sidebar=collapsed]:hidden">
				<img class="dark:hidden" src="{{ asset('images/logo/logo.svg', 'admin') }}" alt="Logo"/>
				<img class="hidden dark:block" src="{{ asset('images/logo/logo-dark.svg', 'admin') }}" alt="Logo"/>
			</span>

			<img class="logo-icon group-data-[sidebar=collapsed]:lg:block group-data-[sidebar=expanded]:hidden" src="{{ asset('images/logo/logo-icon.svg', 'admin') }}" alt="Logo"/>
		</a>
	</div>
	<!-- SIDEBAR HEADER -->

	<div
		class="flex flex-col overflow-y-auto duration-300 ease-linear no-scrollbar">
		<!-- Sidebar Menu -->
		<nav
			x-data="{selected: $persist('Dashboard')}">
			<!-- Menu Group -->
			<div>
				<h3 class="mb-4 text-xs uppercase leading-[20px] text-gray-400">
					<span class="menu-group-title group-data-[sidebar=collapsed]:lg:hidden">
						MENU
					</span>
					{{ ux_icon('heroicons:ellipsis-horizontal', { class: 'w-6 h-6 mx-auto fill-current menu-group-icon
						group-data-[sidebar=collapsed]:lg:block
						group-data-[sidebar=collapsed]:hidden
						group-data-[sidebar=expanded]:hidden' }) }}
				</h3>

				<ul
					class="flex flex-col gap-4 mb-6">
					<!-- Menu Item Dashboard -->
					<li class="group-menu-dashboard">
						{# Call twig function (custom extension) to determine classes values #}
						{% set dashboard = get_menu_classes(active_menu, active_page, 'dashboard', 'dashboard') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="dashboard"
							class="menu-item group {{ dashboard.item_class }}">
							
							{{ ux_icon('heroicons:squares-2x2', { class: 'w-6 h-6 ' ~ dashboard.item_icon_class }) }}
							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Dashboard
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ dashboard.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start -->
						<div class="overflow-hidden transform translate {{ dashboard.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_index')}}" class="menu-dropdown-item group {{ dashboard.dropdown_item_class }}">
										eCommerce
									</a>
								</li>
								<li>
									{% set dashboard = get_menu_classes(active_menu, active_page, 'dashboard', 'pokemon_list') %}
									<a href="{{ path('app_backend_pokemons')}}" class="menu-dropdown-item group {{ dashboard.dropdown_item_class }}">
										Pokemons
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Dashboard -->

					<!-- Menu Item Usuarios -->
					{% if is_granted('ROLE_ADMIN') %}
					<li>
						{% set userList = get_menu_classes(active_menu, active_page, 'user_profile', 'user_list') %}
						<a href="{{ path('app_backend_users') }}"
							class="menu-item group {{ userList.item_class }}">
							{{ ux_icon('heroicons:users', { class: 'w-6 h-6 '~ userList.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Usuarios
							</span>
						</a>
					</li>
					{% endif %}
					<!-- Menu Item Usuarios -->

					<!-- Menu Item Forms -->
					<li class="group-menu-forms">
						{% set menuForms = get_menu_classes(active_menu, active_page, 'forms', 'form_elements') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="forms"
							class="menu-item group {{ menuForms.item_class }}">
							{{ ux_icon('heroicons:document-text', { class: 'w-6 h-6 '~ menuForms.item_icon_class }) }}
							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Forms
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuForms.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start -->
						<div class="overflow-hidden transform translate {{ menuForms.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_form') }}" class="menu-dropdown-item group {{ menuForms.dropdown_item_class }}">
										Form Elements
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Forms -->

					<!-- Menu Item Tables -->
					<li class="group-menu-tables">
						{% set menuTables = get_menu_classes(active_menu, active_page, 'tables', 'basic_tables') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="tables"
							class="menu-item group {{ menuTables.item_class }}">

							{{ ux_icon('heroicons:table-cells', { class: 'w-6 h-6 '~ menuTables.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Tables
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuTables.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start -->
						<div class="overflow-hidden transform translate {{ menuTables.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_basic_tables') }}" 
										class="menu-dropdown-item group {{ menuTables.dropdown_item_class }}">
										Basic Tables
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Tables -->

					<!-- Menu Item Pages -->
					<li class="group-menu-pages">
						{% set menuPages = get_menu_classes(active_menu, active_page, 'pages', 'blank_page') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="pages"
							class="menu-item group {{ menuPages.item_class }}">

							{{ ux_icon('heroicons:document-duplicate', { class: 'w-6 h-6 '~ menuPages.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Pages
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuPages.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start -->
						<div class="overflow-hidden transform translate {{ menuPages.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_blank_page') }}" class="menu-dropdown-item group {{ menuPages.dropdown_item_class }}">
										Blank Page
									</a>
								</li>
								<li>
									{% set menuPages = get_menu_classes(active_menu, active_page, 'pages', 'page_404') %}
									<a href="{{ path('app_design_page_404') }}" class="menu-dropdown-item group {{ menuPages.dropdown_item_class }}">
										404 Error
									</a>
								</li>
								<li>
									{% set menuPages = get_menu_classes(active_menu, active_page, 'pages', 'page_500') %}
									<a href="{{ path('app_design_page_500') }}" class="menu-dropdown-item group {{ menuPages.dropdown_item_class }}">
										500 Error
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>	
					<!-- Menu Item Pages -->
				</ul>
			</div>

			<!-- Others Group -->
			<div>
				<h3 class="mb-4 text-xs uppercase leading-[20px] text-gray-400">
					<span class="menu-group-title group-data-[sidebar=collapsed]:lg:hidden">
						others
					</span>
					{{ ux_icon('heroicons:ellipsis-horizontal', { class: 'w-6 h-6 mx-auto fill-current menu-group-icon
						group-data-[sidebar=collapsed]:lg:block
						group-data-[sidebar=collapsed]:hidden
						group-data-[sidebar=expanded]:hidden' }) }}
				</h3>

				<ul
					class="flex flex-col gap-4 mb-6">
					<!-- Menu Item Charts -->
					<li class="group-menu-charts">
						{% set menuCharts = get_menu_classes(active_menu, active_page, 'charts', 'line_chart') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="charts"
							class="menu-item group {{ menuCharts.item_class }}">
							
							{{ ux_icon('heroicons:chart-pie', { class: 'w-6 h-6 '~ menuCharts.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Charts
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuCharts.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start - Charts -->
						<div class="overflow-hidden transform translate {{ menuCharts.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9 
								group-data-[sidebar=collapsed]:lg:hidden 
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_charts_line_chart') }}" class="menu-dropdown-item group {{ menuCharts.dropdown_item_class }}">
										Line Chart
									</a>
								</li>
								<li>
									{% set menuCharts = get_menu_classes(active_menu, active_page, 'charts', 'bar_chart') %}
									<a href="{{ path('app_design_charts_bar_chart') }}" class="menu-dropdown-item group {{ menuCharts.dropdown_item_class }}">
										Bar Chart
									</a>
								</li>
								<li>
									{% set menuCharts = get_menu_classes(active_menu, active_page, 'charts', 'pie_chart') %}
									<a href="{{ path('app_design_charts_pie_chart') }}" class="menu-dropdown-item group {{ menuCharts.dropdown_item_class }}">
										Pie Chart
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Charts -->

					<!-- Menu Item Ui Elements  -->

					<li class="group-menu-ui-elements">
						{% set menuElements = get_menu_classes(active_menu, active_page, 'ui_elements', 'ui_alerts') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="ui-elements"
							class="menu-item group {{ menuElements.item_class }}">

							{{ ux_icon('heroicons:cube', { class: 'w-6 h-6 '~ menuElements.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								UI Elements
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuElements.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start -->
						<div class="overflow-hidden transform translate {{ menuElements.dropdown_class }}">
							<ul
								class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex
								">
								<li>
									<a href="{{ path('app_design_ui_elements_alerts') }}" class="menu-dropdown-item group {{ menuElements.dropdown_item_class }}">
										Alerts
									</a>
								</li>
								<li>
									{% set menuElements = get_menu_classes(active_menu, active_page, 'ui_elements', 'ui_badge') %}
									<a href="{{ path('app_design_ui_elements_badge') }}" class="menu-dropdown-item group {{ menuElements.dropdown_item_class }}">
										Badges
									</a>
								</li>
								<li>
									{% set menuElements = get_menu_classes(active_menu, active_page, 'ui_elements', 'ui_buttons') %}
									<a href="{{ path('app_design_ui_elements_buttons') }}" class="menu-dropdown-item group {{ menuElements.dropdown_item_class }}">
										Buttons
									</a>
								</li>
								<li>
									{% set menuElements = get_menu_classes(active_menu, active_page, 'ui_elements', 'ui_images') %}
									<a href="{{ path('app_design_ui_elements_images') }}" class="menu-dropdown-item group {{ menuElements.dropdown_item_class }}">
										Images
									</a>
								</li>
								<li>
									{% set menuElements = get_menu_classes(active_menu, active_page, 'ui_elements', 'ui_videos') %}
									<a href="{{ path('app_design_ui_elements_videos') }}" class="menu-dropdown-item group {{ menuElements.dropdown_item_class }}">
										Videos
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Ui Elements -->

					<!-- Menu Item Authentication -->
					<li class="group-menu-auth">
						{% set menuAuth = get_menu_classes(active_menu, active_page, 'auth') %}
						<a href="#" 
							data-action="click->template-base#setSelectedMenu"
							data-template-base-selected-menu-param="auth"
							class="menu-item group  {{ menuAuth.item_class }}">
							
							{{ ux_icon('heroicons:shield-check', { class: 'w-6 h-6 '~ menuAuth.item_icon_class }) }}

							<span class="menu-item-text group-data-[sidebar=collapsed]:lg:hidden">
								Authentication
							</span>

							{{ ux_icon('heroicons:chevron-down', { class: 'w-5 h-5 menu-item-arrow 
								group-data-[sidebar=collapsed]:lg:hidden '~ menuAuth.arrow_icon_class }) }}
						</a>

						<!-- Dropdown Menu Start - Auth -->
						<div class="overflow-hidden transform translate {{ menuAuth.dropdown_class }}">
							<ul class="flex flex-col gap-1 mt-2 menu-dropdown pl-9
								group-data-[sidebar=collapsed]:lg:hidden
								group-data-[sidebar=expanded]:flex">
								<li>
									<a href="{{ path('app_design_auth_sign_in') }}" class="menu-dropdown-item group {{ menuAuth.dropdown_item_class }}">
										Sign In
									</a>
								</li>
								<li>
									<a href="{{ path('app_design_auth_sign_up') }}" class="menu-dropdown-item group {{ menuAuth.dropdown_item_class }}">
										Sign Up
									</a>
								</li>
							</ul>
						</div>
						<!-- Dropdown Menu End -->
					</li>
					<!-- Menu Item Authentication -->
				</ul>
			</div>
		</nav>
		<!-- Sidebar Menu -->

		<!-- Promo Box -->
		<div class="sidebar-promo-box mx-auto mb-10 w-full max-w-60 rounded-2xl bg-gray-50 px-4 py-5 text-center dark:bg-white/[0.03]
			group-data-[sidebar=collapsed]:lg:hidden">
			<h3 class="mb-2 font-semibold text-gray-900 dark:text-white">
				#1 Tailwind CSS Dashboard
			</h3>
			<p class="mb-4 text-gray-500 text-theme-sm dark:text-gray-400">
				Leading Tailwind CSS Admin Template with 400+ UI Component and Pages.
			</p>
			<a href="https://tailadmin.com/pricing" target="_blank" rel="nofollow" class="flex items-center justify-center p-3 font-medium text-white rounded-lg bg-brand-500 text-theme-sm hover:bg-brand-600">
				Purchase Plan
			</a>
		</div>
		<!-- Promo Box -->
	</div>
</aside>
