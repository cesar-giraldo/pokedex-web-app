<div
	data-controller="component-password-input"
	data-component-password-input-disabled-value="{{ disabled ? 'true' : 'false' }}"
	class="relative"
	{{ attributes }}
>
	<label for="{{ id }}" class="{{ labelClasses }}">
		{{ label }}
		{% if required %}
			<span class="text-error-500" aria-hidden="true">*</span>
		{% endif %}
	</label>

	<div class="relative w-full">
		<input
			id="{{ id }}"
			name="{{ name }}"
			type="password"
			value="{{ value }}"
			placeholder="{{ placeholder }}"
			autocomplete="{{ autocomplete }}"
			data-component-password-input-target="input"
			class="{{ inputClasses }}"
			{% if required %}required{% endif %}
			{% if disabled %}disabled{% endif %}
			{% if error %}
				aria-invalid="true"
				aria-describedby="{{ id }}-error{% if help %} {{ id }}-help{% endif %}"
			{% elseif help %}
				aria-describedby="{{ id }}-help"
			{% endif %}
		>

		<button
			type="button"
			data-component-password-input-target="toggle"
			data-action="click->component-password-input#toggleVisibility"
			class="absolute top-1/2 right-4 z-10 -translate-y-1/2 text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
			aria-label="Mostrar contraseña"
			aria-pressed="false"
			{% if disabled %}disabled tabindex="-1"{% endif %}
		>
			<span data-component-password-input-target="showIcon">
				{{ ux_icon('heroicons:eye', { class: 'w-5 h-5' }) }}
			</span>
			<span data-component-password-input-target="hideIcon" class="hidden">
				{{ ux_icon('heroicons:eye-slash', { class: 'w-5 h-5' }) }}
			</span>
		</button>
	</div>

	{% if error %}
		<p id="{{ id }}-error" class="text-theme-xs text-error-500 mt-1.5" role="alert">{{ error }}</p>
	{% endif %}

	{% if help %}
		<p id="{{ id }}-help" class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">{{ help }}</p>
	{% endif %}
</div>
