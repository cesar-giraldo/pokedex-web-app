<div
	id="{{ id }}"
	data-controller="component-alert"
	data-component-alert-auto-hide-delay-value="{{ autoHideDelay }}"
	data-component-alert-dismissible-value="{{ dismissible ? 'true' : 'false' }}"
	class="relative rounded-xl border border-error-500 bg-error-50 p-4 opacity-100 dark:border-error-500/30 dark:bg-error-500/15"
	role="alert"
	aria-live="assertive"
	{{ attributes }}
>
	{% if dismissible %}
		<button
			type="button"
			class="absolute top-3 right-3 inline-flex items-center justify-center rounded-md p-1 text-gray-500 transition hover:bg-error-500/10 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
			data-action="component-alert#dismiss"
			aria-label="Cerrar notificación"
		>
			{{ ux_icon('heroicons:x-mark', { class: 'w-5 h-5' }) }}
		</button>
	{% endif %}

	<div class="flex items-start gap-3{% if dismissible %} pr-8{% endif %}">
		<div class="-mt-0.5 shrink-0 text-error-500 dark:text-error-400">
			{{ ux_icon('heroicons:exclamation-circle', { class: 'w-6 h-6 fill-current' }) }}
		</div>
		<p class="text-sm text-gray-700 dark:text-gray-300">{{ message }}</p>
	</div>
</div>
