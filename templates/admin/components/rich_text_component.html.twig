<div
	class="relative"
	data-controller="component-rich-text"
	data-component-rich-text-disabled-value="{{ disabled ? 'true' : 'false' }}"
	{{ attributes }}
>
	<label for="{{ id }}" class="{{ labelClasses }}">
		{{ label }}
		{% if required %}
			<span class="text-error-500" aria-hidden="true">*</span>
		{% endif %}
	</label>

	<input
		type="hidden"
		id="{{ id }}"
		name="{{ name }}"
		value="{{ value }}"
		data-component-rich-text-target="input"
		{% if required %}required{% endif %}
	>

	<trix-editor
		input="{{ id }}"
		class="trix-content dark:bg-dark-900 shadow-theme-xs mt-0 min-h-48 w-full rounded-lg border bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:bg-gray-900 dark:text-white/90 {% if error %}border-error-300 dark:border-error-700{% else %}border-gray-300 dark:border-gray-700{% endif %}"
		{% if disabled %}contenteditable="false" tabindex="-1"{% endif %}
		{% if error %}aria-invalid="true" aria-describedby="{{ id }}-error"{% elseif help %}aria-describedby="{{ id }}-help"{% endif %}
	></trix-editor>

	{% if error %}
		<p id="{{ id }}-error" class="text-theme-xs text-error-500 mt-1.5" role="alert">{{ error }}</p>
	{% endif %}

	{% if help %}
		<p id="{{ id }}-help" class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">{{ help }}</p>
	{% endif %}
</div>
