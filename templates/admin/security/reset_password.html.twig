{% extends '@admin/base_auth.html.twig' %}

{% from '@admin/macros/form.html.twig' import field_error %}

{% block title %}{{ can_reset ? 'Crea una contraseña nueva' : 'Enlace no disponible' }} - Pokedex{% endblock %}

{% block extra_meta %}
	<meta name="robots" content="noindex, nofollow">
	<meta name="referrer" content="no-referrer">
{% endblock %}

{% block body %}
	<div class="w-full max-w-md pt-10 mx-auto">
		<a href="{{ path('app_admin_login') }}" class="inline-flex items-center text-sm text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">
			{{ ux_icon('heroicons:chevron-left', { class: 'w-5 h-5' }) }}
			Volver a iniciar sesión
		</a>
	</div>
	<div class="flex flex-col justify-center flex-1 w-full max-w-md mx-auto">
		<div>
			{% if can_reset %}
				<div class="mb-5 sm:mb-8">
					<h1 class="mb-2 font-semibold text-gray-800 text-title-sm dark:text-white/90 sm:text-title-md">
						Crea una contraseña nueva
					</h1>
					<p class="text-sm text-gray-500 dark:text-gray-400">
						Elige una contraseña nueva. El enlace funciona durante 12 horas y solo se puede usar una vez.
					</p>
				</div>

				{{ form_start(resetForm, {
					method: 'POST',
					attr: { class: 'space-y-5' },
				}) }}
					<twig:component_password_input
						label="Contraseña"
						name="{{ resetForm.plainPassword.vars.full_name }}"
						id="reset-password"
						value=""
						autocomplete="new-password"
						placeholder="Crea una contraseña"
						:maxLength="form_field_max_length(resetForm.plainPassword)"
						:required="true"
						error="{{ field_error(resetForm.plainPassword) }}"
						help="Mínimo 5 caracteres, con letras y números."
					/>

					<twig:component_password_input
						label="Confirmar contraseña"
						name="{{ resetForm.confirmPassword.vars.full_name }}"
						id="reset-password-confirm"
						value=""
						autocomplete="new-password"
						placeholder="Repite la contraseña"
						:maxLength="form_field_max_length(resetForm.confirmPassword)"
						:required="true"
						error="{{ field_error(resetForm.confirmPassword) }}"
					/>

					{{ form_widget(resetForm._token) }}

					<div>
						<twig:component_submit_button
							label="Guardar contraseña"
							processingLabel="Guardando..."
							layout="full"
						/>
					</div>
				{{ form_end(resetForm, { render_rest: false }) }}
			{% else %}
				<div class="mb-5 sm:mb-8">
					<h1 class="mb-2 font-semibold text-gray-800 text-title-sm dark:text-white/90 sm:text-title-md">
						Enlace no disponible
					</h1>
					<p class="text-sm text-gray-500 dark:text-gray-400">
						Este enlace ya no es válido. Solicita uno nuevo.
					</p>
				</div>
				<p class="text-sm">
					<a href="{{ path('app_admin_forgot_password') }}" class="text-brand-500 hover:text-brand-600 dark:text-brand-400">Solicitar un enlace nuevo</a>
				</p>
			{% endif %}
		</div>
	</div>
{% endblock %}
