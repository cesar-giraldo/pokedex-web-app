{% extends '@admin/base_auth.html.twig' %}

{% from '@admin/macros/form.html.twig' import field_error %}

{% block title %}Restablecer contraseña - Pokedex{% endblock %}

{% block body %}
	<div class="w-full max-w-md pt-10 mx-auto">
		<a href="{{ path('app_admin_login') }}" class="inline-flex items-center text-sm text-gray-500 transition-colors hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">
			{{ ux_icon('heroicons:chevron-left', { class: 'w-5 h-5' }) }}
			Volver a iniciar sesión
		</a>
	</div>
	<div class="flex flex-col justify-center flex-1 w-full max-w-md mx-auto">
		<div>
			<div class="mb-5 sm:mb-8">
				<h1 class="mb-2 font-semibold text-gray-800 text-title-sm dark:text-white/90 sm:text-title-md">
					Restablecer contraseña
				</h1>
				<p class="text-sm text-gray-500 dark:text-gray-400">
					Escribe el correo o el nickname con el que te registraste. Si la cuenta se puede recuperar, te enviamos un enlace.
				</p>
			</div>

			{% for message in app.flashes('success') %}
				<div class="mb-4">
					<twig:component_alert_success message="{{ message }}" :autoHideDelay="0" />
				</div>
			{% endfor %}

			{% for error in requestForm.vars.errors %}
				<div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-sm text-error-700 dark:border-error-500/30 dark:bg-error-500/10 dark:text-error-400">
					{{ error.message }}
				</div>
			{% endfor %}

			{{ form_start(requestForm, {
				action: path('app_admin_forgot_password'),
				method: 'POST',
				attr: { class: 'space-y-5' },
			}) }}
				<twig:component_text_input
					label="Correo o nickname"
					name="{{ requestForm.identifier.vars.full_name }}"
					id="forgot-password-identifier"
					value="{{ requestForm.identifier.vars.value|default('') }}"
					autocomplete="username"
					placeholder="correo o nickname"
					:maxLength="form_field_max_length(requestForm.identifier)"
					:required="true"
					error="{{ field_error(requestForm.identifier) }}"
				/>

				{{ form_widget(requestForm._token) }}

				<div>
					<twig:component_submit_button
						label="Enviar enlace"
						processingLabel="Enviando..."
						layout="full"
					/>
				</div>
			{{ form_end(requestForm, { render_rest: false }) }}
		</div>
	</div>
{% endblock %}
