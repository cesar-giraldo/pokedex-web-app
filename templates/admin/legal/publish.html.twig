{% extends '@admin/base.html.twig' %}

{% block page_title %}Publicar v{{ version.versionNumber }}{% endblock %}
{% block title %}Publicar {{ document.name }}{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal') }}">
			Legal
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal_show', { type: document.type.value }) }}">
			{{ document.name }}
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Publicar v{{ version.versionNumber }}</li>
{% endblock %}

{% block body %}
	<form method="post" class="max-w-2xl space-y-5 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] sm:p-6">
		<input type="hidden" name="_token" value="{{ csrf_token('legal_publish_' ~ version.id) }}">
		<p class="text-sm text-gray-500 dark:text-gray-400">La publicación exige una traducción completa de cada idioma habilitado. Las traducciones ya publicadas no se modifican.</p>

		{% if first_release %}
			<input type="hidden" name="requires_reacceptance" value="1">
			<p class="text-sm text-gray-800 dark:text-white/90">La primera versión siempre exige aceptación.</p>
		{% else %}
			<twig:component_checkbox
				label="Exigir una nueva aceptación"
				name="requires_reacceptance"
				id="requires-reacceptance"
				value="1"
				:checked="true"
				help="Desmárcalo solo para cambios cosméticos. No se notificará ni se bloqueará a los usuarios."
			/>
		{% endif %}

		<div>
			<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" for="notification-title">Título de la notificación</label>
			<input id="notification-title" name="notification_title" value="{{ notification_title }}" class="shadow-theme-xs w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
		</div>
		<div>
			<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" for="notification-message">Mensaje de la notificación</label>
			<textarea id="notification-message" name="notification_message" rows="4" class="shadow-theme-xs w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">{{ notification_message }}</textarea>
		</div>

		<twig:component_submit_button
			label="Publicar versión"
			processingLabel="Almacenando documento y notificando a los usuarios..."
		/>
	</form>
{% endblock %}
