{% extends '@admin/base.html.twig' %}

{% block page_title %}Previsualizar v{{ version.versionNumber }}{% endblock %}
{% block title %}Previsualizar {{ document.name }}{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-500 dark:text-gray-400"><a href="{{ path('app_backend_legal_show', { type: document.type.value }) }}">{{ document.name }}</a></li>
	<li class="text-sm text-gray-800 dark:text-white/90">Vista previa v{{ version.versionNumber }}</li>
{% endblock %}

{% block body %}
	<section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] sm:p-6">
		<nav class="mb-6 flex flex-wrap gap-3" aria-label="Idioma de la vista previa">
			{% for language in languages %}
				<a class="text-sm font-medium {{ preferred.value == language.code ? 'text-brand-500' : 'text-gray-500' }}" href="{{ path('app_backend_legal_preview', { type: document.type.value, versionNumber: version.versionNumber, lang: language.code }) }}">{{ language.label }}</a>
			{% endfor %}
		</nav>
		{% if translation %}
			<h2 class="text-xl font-medium text-gray-800 dark:text-white/90">{{ translation.title }}</h2>
			{% if translation.summary %}
				<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{{ translation.summary }}</p>
			{% endif %}
			<div class="prose mt-6 max-w-none text-sm text-gray-800 dark:text-white/90">{{ translation.contentHtml|raw }}</div>
			<p class="mt-8 text-sm text-gray-700 dark:text-gray-300">{{ translation.acceptanceLabel }}</p>
		{% else %}
			<p class="text-sm text-gray-500">No hay contenido para este idioma ni para el idioma por defecto.</p>
		{% endif %}
	</section>
{% endblock %}
