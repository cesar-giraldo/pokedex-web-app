{% extends '@admin/base.html.twig' %}

{% block page_title %}Aceptar documento{% endblock %}
{% block title %}{{ translation.title }}{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Aceptación legal</li>
{% endblock %}

{% block body %}
	<section class="mx-auto max-w-3xl rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
		<header class="border-b border-gray-100 px-5 py-4 dark:border-gray-800 sm:px-6">
			<h2 class="text-lg font-medium text-gray-800 dark:text-white/90">{{ translation.title }}</h2>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ version.document.name }} · v{{ version.versionNumber }}</p>
			{% if translation.summary %}
				<p class="mt-3 text-sm text-gray-700 dark:text-gray-300">{{ translation.summary }}</p>
			{% endif %}
		</header>
		<form method="post" class="px-5 py-5 sm:px-6">
			<input type="hidden" name="_token" value="{{ csrf_token('legal_accept') }}">
			<div class="max-h-[50vh] overflow-y-auto rounded-lg border border-gray-200 p-4 text-sm text-gray-800 dark:border-gray-800 dark:text-white/90" tabindex="0">
				{{ translation.contentHtml|raw }}
			</div>
			<div class="mt-5">
				<twig:component_checkbox
					label="{{ translation.acceptanceLabel }}"
					name="accepted"
					id="legal-accepted"
					value="1"
					:required="true"
					error="{{ error }}"
				/>
			</div>
			<div class="mt-6">
				<twig:component_submit_button label="Aceptar y continuar" processingLabel="Registrando aceptación..." />
			</div>
		</form>
	</section>
{% endblock %}
