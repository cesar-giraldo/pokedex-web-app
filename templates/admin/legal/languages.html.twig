{% extends '@admin/base.html.twig' %}

{% block page_title %}Completar idiomas{% endblock %}
{% block title %}Completar idiomas{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal') }}">
			Legal
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal_show', { type: document.type.value }) }}">
			{{ document.name }}
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Idiomas de v{{ version.versionNumber }}</li>
{% endblock %}

{% block body %}
	<form method="post" class="space-y-6">
		<input type="hidden" name="_token" value="{{ csrf_token('legal_languages_' ~ version.id) }}">
		<p class="text-sm text-gray-500 dark:text-gray-400">Estas traducciones se añaden a la versión vigente. No generan una nueva aceptación.</p>
		{% include '@admin/legal/_translation_fields.html.twig' %}
		<twig:component_submit_button label="Guardar idiomas" processingLabel="Guardando traducciones..." />
	</form>
{% endblock %}
