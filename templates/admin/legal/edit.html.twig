{% extends '@admin/base.html.twig' %}

{% block page_title %}Editar v{{ version.versionNumber }}{% endblock %}
{% block title %}Editar {{ document.name }}{% endblock %}

{% block breadcrumb %}
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal') }}">
			Legal
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li>
		<a class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" href="{{ path('app_backend_legal_show', { type: document.type.value }) }}">
			{{ document.name }}
			{{ ux_icon('heroicons:chevron-right', { class: 'w-4 h-4' }) }}
		</a>
	</li>
	<li class="text-sm text-gray-800 dark:text-white/90">Borrador v{{ version.versionNumber }}</li>
{% endblock %}

{% block body %}
	<div data-controller="legal-draft-delete">
		<form method="post" class="space-y-6">
			<input type="hidden" name="_token" value="{{ csrf_token('legal_draft_save_' ~ version.id) }}">
			{% include '@admin/legal/_translation_fields.html.twig' %}
			<div class="flex flex-wrap items-center gap-3">
				<twig:component_submit_button label="Guardar borrador" processingLabel="Guardando borrador..." />
				<button
					type="button"
					data-action="legal-draft-delete#request"
					class="inline-flex items-center gap-2 rounded-lg bg-error-500 px-5 py-3 text-sm font-medium text-white shadow-theme-xs transition hover:bg-error-600"
				>
					{{ ux_icon('heroicons:trash', { class: 'h-4 w-4' }) }}
					Eliminar borrador
				</button>
			</div>
		</form>

		<form
			method="post"
			action="{{ path('app_backend_legal_draft_delete', { type: document.type.value, versionNumber: version.versionNumber }) }}"
			data-legal-draft-delete-target="form"
			hidden
		>
			<input type="hidden" name="_token" value="{{ csrf_token('legal_draft_delete_' ~ version.id) }}">
		</form>

		<twig:component_confirm_dialog
			id="legal-draft-delete-dialog"
			title="Eliminar borrador"
			message="¿Seguro que deseas eliminar el borrador v{{ version.versionNumber }} de {{ document.name }}? Esta acción no se puede deshacer."
			cancelLabel="Cancelar"
			confirmLabel="Eliminar borrador"
		/>
	</div>
{% endblock %}
