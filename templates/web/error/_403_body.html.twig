<div class="mx-auto max-w-lg px-4 py-20 text-center">
    <p class="text-sm font-medium text-brand">403</p>
    <h1 class="mt-3 text-3xl font-extrabold">{{ 'error.forbidden_title'|trans }}</h1>
    <p class="mt-4 text-muted">{{ message|default('error.forbidden_body'|trans) }}</p>
    <a href="{{ home_url|default(path('app_home')) }}" class="btn btn-primary mt-8">{{ home_label|default('error.home'|trans) }}</a>
</div>
