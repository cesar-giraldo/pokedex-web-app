{% set variant = variant|default('dropdown') %}

{% macro option_icon(name) %}
    {{ ux_icon(name, { class: 'account-menu-icon h-5 w-5 shrink-0', 'aria-hidden': 'true' }) }}
{% endmacro %}

{% import _self as menu %}

{% if variant == 'icon' %}
    <details class="relative" data-controller="account-menu">
        <summary class="site-summary grid h-11 w-11 cursor-pointer place-items-center overflow-hidden rounded-full text-ink ring-1 ring-black/10 hover:bg-surface hover:text-brand" title="{{ app.user.name }}">
            {% if app.user.profileImagePath %}
                <img src="{{ path('app_public_profile_avatar', {_locale: locale}) }}" alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover">
            {% else %}
                {{ ux_icon('heroicons:user', { class: 'h-5 w-5', 'aria-hidden': 'true' }) }}
            {% endif %}
        </summary>
        <div class="absolute -right-[3.25rem] z-20 mt-2 flex w-64 flex-col gap-2 rounded-3xl bg-white p-4 shadow-lg ring-1 ring-black/10">
            {% include _self with {variant: 'list'} %}
        </div>
    </details>
{% elseif variant == 'list' %}
    <p class="text-sm font-semibold text-ink">{{ app.user.name }} {{ app.user.lastname }}</p>
    <a class="btn btn-secondary" href="{{ path('app_public_profile', {_locale: locale}) }}" {% if current == 'app_public_profile' %}aria-current="page"{% endif %}>
        {{ menu.option_icon('heroicons:user-circle') }}
        {{ 'nav.profile'|trans }}
    </a>
    <a class="btn btn-secondary" href="{{ path('app_public_favorites', {_locale: locale}) }}" {% if current == 'app_public_favorites' %}aria-current="page"{% endif %}>
        {{ menu.option_icon('heroicons:heart') }}
        {{ 'nav.favorites'|trans }}
    </a>
    <a class="btn btn-primary" data-turbo-prefetch="false" href="{{ path('app_public_logout', {_locale: locale}) }}">
        {{ menu.option_icon('heroicons:arrow-left-start-on-rectangle') }}
        {{ 'nav.logout'|trans }}
    </a>
{% else %}
    <details class="account-menu relative" data-controller="account-menu">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pr-2 pl-1 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {% if app.user.profileImagePath %}
                <img src="{{ path('app_public_profile_avatar', {_locale: locale}) }}" alt="" width="36" height="36" class="h-9 w-9 rounded-full object-cover">
            {% else %}
                <span class="grid h-9 w-9 place-items-center rounded-full bg-brand text-sm font-bold text-white" aria-hidden="true">{{ app.user.name|slice(0, 1)|upper }}</span>
            {% endif %}
            <span class="max-w-32 truncate">{{ app.user.name }}</span>
            {{ ux_icon('heroicons:chevron-down', { class: 'account-menu-chevron h-4 w-4', 'aria-hidden': 'true' }) }}
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-64 rounded-3xl bg-white p-3 shadow-lg ring-1 ring-black/10">
            <div class="px-2">
                <p class="truncate text-sm font-semibold text-ink">{{ app.user.name }} {{ app.user.lastname }}</p>
                <p class="mt-0.5 truncate text-xs text-muted">
                    {% if app.user.email %}
                        {{ app.user.email }}
                    {% else %}
                        @{{ app.user.nickname }}
                    {% endif %}
                </p>
            </div>
            <div class="mt-3 flex flex-col gap-1 border-b border-black/10 pb-2">
                <a class="flex items-center gap-3 rounded-2xl px-3 py-2 text-sm font-medium hover:bg-surface" href="{{ path('app_public_profile', {_locale: locale}) }}" {% if current == 'app_public_profile' %}aria-current="page"{% endif %}>
                    {{ menu.option_icon('heroicons:user-circle') }}
                    {{ 'nav.profile'|trans }}
                </a>
                <a class="flex items-center gap-3 rounded-2xl px-3 py-2 text-sm font-medium hover:bg-surface" href="{{ path('app_public_favorites', {_locale: locale}) }}" {% if current == 'app_public_favorites' %}aria-current="page"{% endif %}>
                    {{ menu.option_icon('heroicons:heart') }}
                    {{ 'nav.favorites'|trans }}
                </a>
            </div>
            <a class="mt-2 flex items-center gap-3 rounded-2xl px-3 py-2 text-sm font-medium hover:bg-surface" data-turbo-prefetch="false" href="{{ path('app_public_logout', {_locale: locale}) }}">
                {{ menu.option_icon('heroicons:arrow-left-start-on-rectangle') }}
                {{ 'nav.logout'|trans }}
            </a>
        </div>
    </details>
{% endif %}
