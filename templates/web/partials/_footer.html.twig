{% set locale = app.request.locale %}
{% set current = app.request.attributes.get('_route') %}
{% set legal = public_legal_links() %}
{% set show_legal = legal.privacy or legal.terms %}
<footer class="border-t border-black/5 bg-surface">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 {{ show_legal ? 'md:grid-cols-4' : 'md:grid-cols-3' }}">
        <div>
            <p class="text-lg font-extrabold">{{ public_site_name() }}</p>
            {% set slogan = public_site_slogan() %}
            <p class="mt-2 text-sm leading-6 text-muted">{{ slogan|default('footer.tagline'|trans) }}</p>
            {% include '@web/partials/_language_switcher.html.twig' with {variant: 'footer'} %}
        </div>
        <nav aria-label="{{ 'footer.explore'|trans }}">
            <p class="text-sm font-medium text-muted">{{ 'footer.explore'|trans }}</p>
            <ul class="mt-3 space-y-2">
                <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_home', {_locale: locale}) }}" {% if current == 'app_public_home' %}aria-current="page"{% endif %}>{{ 'nav.home'|trans }}</a></li>
                <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_pokedex', {_locale: locale}) }}" {% if current in ['app_public_pokedex', 'app_public_pokemon'] %}aria-current="page"{% endif %}>{{ 'nav.pokemon'|trans }}</a></li>
                <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_about', {_locale: locale}) }}" {% if current == 'app_public_about' %}aria-current="page"{% endif %}>{{ 'nav.about'|trans }}</a></li>
                <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_contact', {_locale: locale}) }}" {% if current == 'app_public_contact' %}aria-current="page"{% endif %}>{{ 'nav.contact'|trans }}</a></li>
            </ul>
        </nav>
        {% if show_legal %}
            <nav aria-label="{{ 'footer.legal'|trans }}">
                <p class="text-sm font-medium text-muted">{{ 'footer.legal'|trans }}</p>
                <ul class="mt-3 space-y-2">
                    {% if legal.privacy %}
                        <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_privacy', {_locale: locale}) }}" {% if current == 'app_public_privacy' %}aria-current="page"{% endif %}>{{ 'nav.privacy'|trans }}</a></li>
                    {% endif %}
                    {% if legal.terms %}
                        <li><a class="text-sm font-medium hover:text-brand" href="{{ path('app_public_terms', {_locale: locale}) }}" {% if current == 'app_public_terms' %}aria-current="page"{% endif %}>{{ 'nav.terms'|trans }}</a></li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
        <div>
            <p class="text-sm font-medium text-muted">{{ 'nav.contact'|trans }}</p>
            <ul class="mt-3 space-y-2 text-sm">
                <li><a class="font-medium hover:text-brand" href="tel:+576015550142">{{ 'contact.phone'|trans }}</a></li>
                <li><a class="font-medium hover:text-brand" href="mailto:{{ 'contact.email'|trans }}">{{ 'contact.email'|trans }}</a></li>
                <li>{{ 'contact.address'|trans }}</li>
            </ul>
        </div>
    </div>
</footer>
