{% set inbox = inbox|default(header_notifications()) %}
{% set panel_id = panel_id|default('header-notifications') %}
<div
    class="group relative"
    data-controller="header-notifications"
    data-header-notifications-hide-class="hidden"
    data-notifications-status="{{ inbox.unreadCount > 0 ? 'unread' : 'read' }}"
>
    <button
        type="button"
        class="relative grid h-11 w-11 place-items-center rounded-full text-ink ring-1 ring-black/10 transition-colors hover:bg-surface hover:text-brand"
        data-header-notifications-target="toggle"
        data-action="click->header-notifications#toggleNotificationsDropdown"
        aria-label="{{ 'notifications.open'|trans }}"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="{{ panel_id }}"
    >
        <span
            class="absolute top-0 right-0 z-10 h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-white group-data-[notifications-status=read]:hidden"
            data-notification-unread-dot
        ></span>
        {{ ux_icon('heroicons:bell', { class: 'h-5 w-5', 'aria-hidden': 'true' }) }}
    </button>

    <div
        id="{{ panel_id }}"
        data-header-notifications-target="notificationsDropdown"
        class="notifications-dropdown z-30 mt-2 hidden"
        aria-labelledby="{{ panel_id }}-title"
    >
        <div class="flex max-h-[28rem] flex-col rounded-3xl bg-white p-3 shadow-lg ring-1 ring-black/10">
            <div class="mb-2 flex items-center justify-between border-b border-black/5 px-2 pb-3">
                <p id="{{ panel_id }}-title" class="text-base font-extrabold tracking-tight text-ink">
                    {{ 'notifications.title'|trans }}
                </p>
                <button
                    type="button"
                    class="grid h-9 w-9 place-items-center rounded-full text-muted hover:bg-surface hover:text-ink"
                    data-action="click->header-notifications#closeNotificationsDropdown"
                    aria-label="{{ 'notifications.close'|trans }}"
                >
                    {{ ux_icon('heroicons:x-mark', { class: 'h-5 w-5', 'aria-hidden': 'true' }) }}
                </button>
            </div>

            <ul class="flex flex-col overflow-y-auto">
                {% for notification in inbox.items %}
                    <li>
                        <form method="post" action="{{ path('app_public_notification_open', { _locale: app.request.locale, id: notification.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_open') }}">
                            <button type="submit" class="flex w-full cursor-pointer gap-3 rounded-2xl px-2 py-3 text-left hover:bg-surface">
                                <span class="relative grid h-10 w-10 shrink-0 place-items-center rounded-full bg-surface text-brand">
                                    {% if notification.readAt is null %}
                                        <span class="absolute top-0 right-0 z-10 h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-white" data-notification-item-unread aria-hidden="true"></span>
                                    {% endif %}
                                    {{ ux_icon('heroicons:bell', { class: 'h-5 w-5', 'aria-hidden': 'true' }) }}
                                </span>
                                <span class="min-w-0">
                                    {% if notification.readAt is null %}
                                        <span class="sr-only">{{ 'notifications.unread'|trans }}</span>
                                    {% endif %}
                                    <span class="block text-sm font-semibold text-ink">{{ notification.title }}</span>
                                    <span class="mt-0.5 block text-sm text-muted">{{ notification.message }}</span>
                                    <span class="mt-1.5 flex items-center gap-2 text-xs text-muted">
                                        <span>{{ ('notifications.type.' ~ notification.type.value|replace({'.': '_'}))|trans }}</span>
                                        <span class="h-1 w-1 rounded-full bg-muted" aria-hidden="true"></span>
                                        <time datetime="{{ notification.createdAt|date('c') }}" title="{{ notification.createdAt|app_datetime }}">
                                            {{ notification.createdAt|app_datetime_relative }}
                                        </time>
                                    </span>
                                </span>
                            </button>
                        </form>
                    </li>
                {% else %}
                    <li class="px-2 py-8 text-center text-sm text-muted">
                        {{ 'notifications.empty'|trans }}
                    </li>
                {% endfor %}
            </ul>

            <a href="{{ path('app_public_notifications', { _locale: app.request.locale }) }}" class="btn btn-secondary mt-2 w-full">
                {{ 'notifications.see_all'|trans }}
            </a>
        </div>
    </div>
</div>
