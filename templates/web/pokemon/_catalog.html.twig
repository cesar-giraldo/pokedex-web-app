{% set filters = {} %}
{% if page.query %}
    {% set filters = filters|merge({q: page.query}) %}
{% endif %}
{% if page.typeId %}
    {% set filters = filters|merge({type: page.typeId}) %}
{% endif %}

<form class="mt-8 grid gap-3 rounded-3xl bg-surface p-4 md:grid-cols-[1fr_16rem_auto] md:items-end" method="get" action="{{ path(catalog_route, {_locale: app.request.locale}) }}" role="search">
    <div>
        <label class="text-sm font-medium" for="pokemon-q">{{ 'listing.search_label'|trans }}</label>
        <input id="pokemon-q" class="field mt-2" type="search" name="q" value="{{ page.query }}" placeholder="{{ 'listing.search_placeholder'|trans }}">
    </div>
    <div>
        <label class="text-sm font-medium" for="pokemon-type">{{ 'listing.type_label'|trans }}</label>
        <select id="pokemon-type" class="field mt-2" name="type">
            <option value="">{{ 'listing.type_all'|trans }}</option>
            {% for type in types %}
                <option value="{{ type.id }}" {% if page.typeId == type.id %}selected{% endif %}>{{ type.name|capitalize }}</option>
            {% endfor %}
        </select>
    </div>
    <button class="btn btn-primary h-12" type="submit">{{ 'listing.submit'|trans }}</button>
</form>

<p
    class="mt-8 text-sm font-medium text-muted"
    data-favorite-results
    data-favorite-results-count="{{ page.total }}"
    data-favorite-results-labels="{{ {
        zero: 'listing.results'|trans({count: 0}),
        one: 'listing.results'|trans({count: 1}),
        other: 'listing.results'|trans({count: 2})
    }|json_encode|e('html_attr') }}"
>{{ 'listing.results'|trans({count: page.total}) }}</p>

<p class="mt-6 rounded-3xl bg-surface px-6 py-10 text-muted" data-catalog-empty {% if page.pokemons is not empty %}hidden{% endif %}>{{ empty_message }}</p>

<ul class="mt-6 grid gap-5 sm:grid-cols-3 lg:grid-cols-4" data-catalog-grid {% if page.pokemons is empty %}hidden{% endif %}>
    {% for pokemon in page.pokemons %}
        {% include '@web/pokemon/_card.html.twig' with {
            pokemon: pokemon,
            cover: page.covers[pokemon.id]|default(null),
            favorite_gate: favorite_gate,
            is_favorite: pokemon.id in favorite_ids,
            remove_on_unfavorite: remove_on_unfavorite|default(false),
        } only %}
    {% endfor %}
</ul>

{% if page.pageCount > 1 %}
    <nav class="mt-10 flex flex-wrap items-center gap-2" aria-label="{{ 'listing.pagination'|trans }}">
        {% if page.hasPrevious %}
            <a class="btn btn-secondary" href="{{ path(catalog_route, {_locale: app.request.locale}|merge(filters)|merge(page.page > 2 ? {page: page.page - 1} : {})) }}">{{ 'listing.previous'|trans }}</a>
        {% endif %}
        {% for number in 1..page.pageCount %}
            {% if number == page.page or (number >= page.page - 2 and number <= page.page + 2) or number == 1 or number == page.pageCount %}
                <a class="btn {{ number == page.page ? 'btn-primary' : 'btn-secondary' }}" href="{{ path(catalog_route, {_locale: app.request.locale}|merge(filters)|merge(number > 1 ? {page: number} : {})) }}" {% if number == page.page %}aria-current="page"{% endif %}>{{ number }}</a>
            {% endif %}
        {% endfor %}
        {% if page.hasNext %}
            <a class="btn btn-secondary" href="{{ path(catalog_route, {_locale: app.request.locale}|merge(filters)|merge({page: page.page + 1})) }}">{{ 'listing.next'|trans }}</a>
        {% endif %}
    </nav>
{% endif %}
