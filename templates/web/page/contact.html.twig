{% extends '@web/base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'contact.meta_description'|trans }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl px-4 py-14">
        <h1 class="text-4xl font-extrabold tracking-tight">{{ 'contact.title'|trans }}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">{{ 'contact.intro'|trans }}</p>

        <ul class="mt-10 grid gap-4 md:grid-cols-2">
            <li class="rounded-3xl bg-surface p-6">
                <h2 class="text-sm font-medium text-muted">{{ 'contact.phone_label'|trans }}</h2>
                <a class="mt-2 block text-xl font-semibold hover:text-brand" href="tel:+576015550142">{{ 'contact.phone'|trans }}</a>
            </li>
            <li class="rounded-3xl bg-surface p-6">
                <h2 class="text-sm font-medium text-muted">{{ 'contact.email_label'|trans }}</h2>
                <a class="mt-2 block text-xl font-semibold hover:text-brand" href="mailto:{{ 'contact.email'|trans }}">{{ 'contact.email'|trans }}</a>
            </li>
            <li class="rounded-3xl bg-surface p-6">
                <h2 class="text-sm font-medium text-muted">{{ 'contact.address_label'|trans }}</h2>
                <p class="mt-2 text-xl font-semibold">{{ 'contact.address'|trans }}</p>
            </li>
            <li class="rounded-3xl bg-surface p-6">
                <h2 class="text-sm font-medium text-muted">{{ 'contact.hours_label'|trans }}</h2>
                <p class="mt-2 text-xl font-semibold">{{ 'contact.hours'|trans }}</p>
            </li>
        </ul>
    </div>
{% endblock %}
