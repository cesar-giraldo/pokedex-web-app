{% extends '@web/base.html.twig' %}

{% block title %}{{ 'about.title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'about.meta_description'|trans({'name': public_site_name()}) }}{% endblock %}

{% block body %}
    <article class="mx-auto max-w-3xl px-4 py-14">
        <p class="text-sm font-medium text-brand">{{ public_site_name() }}</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight">{{ 'about.title'|trans }}</h1>
        <p class="mt-6 text-lg leading-8 text-muted">{{ 'about.intro'|trans }}</p>

        <section class="mt-12">
            <h2 class="text-2xl font-semibold">{{ 'about.mission_title'|trans }}</h2>
            <p class="mt-4 leading-7">{{ 'about.mission_body'|trans }}</p>
        </section>
        <section class="mt-10">
            <h2 class="text-2xl font-semibold">{{ 'about.collection_title'|trans }}</h2>
            <p class="mt-4 leading-7">{{ 'about.collection_body'|trans }}</p>
        </section>
        <section class="mt-10">
            <h2 class="text-2xl font-semibold">{{ 'about.visit_title'|trans }}</h2>
            <p class="mt-4 leading-7">{{ 'about.visit_body'|trans }}</p>
        </section>
    </article>
{% endblock %}
