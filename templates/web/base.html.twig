<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#820AD1">
        <title>{% block title %}{{ public_site_name() }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ 'seo.default_description'|trans({'name': public_site_name()}) }}{% endblock %}">
        <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
        <link rel="canonical" href="{% block canonical_url %}{{ public_canonical_url() }}{% endblock %}">
        <meta property="og:site_name" content="{{ public_site_name() }}">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:locale" content="{{ public_og_locale(app.request.locale) }}">
        {% for language in public_languages() %}
            {% if language.value != app.request.locale %}
                <meta property="og:locale:alternate" content="{{ language.ogLocale }}">
            {% endif %}
            <link rel="alternate" hreflang="{{ language.value }}" href="{{ public_alternate_url(language.value) }}">
        {% endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ public_alternate_url(public_default_locale()) }}">
        <meta name="twitter:card" content="{% block twitter_card %}summary{% endblock %}">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        {% block social_images %}{% endblock %}
        {% block extra_meta %}{% endblock %}
        {% if structured_data_json is defined and structured_data_json %}
            <script type="application/ld+json">{{ structured_data_json|raw }}</script>
        {% endif %}
        {% set site_icon = public_icon_url() %}
        {% if site_icon %}
            <link rel="icon" href="{{ site_icon }}">
        {% else %}
            <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle fill=%22%23820AD1%22 cx=%2232%22 cy=%2232%22 r=%2232%22/></svg>">
        {% endif %}

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('web') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <a class="skip-link" href="#contenido">{{ 'site.skip_to_content'|trans }}</a>
        {% include '@web/partials/_header.html.twig' %}
        <main id="contenido">
            {% block body %}{% endblock %}
        </main>
        {% include '@web/partials/_footer.html.twig' %}
    </body>
</html>
