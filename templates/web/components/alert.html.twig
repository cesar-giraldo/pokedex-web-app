{% if message %}
    <p class="rounded-2xl px-4 py-3 text-sm font-medium {% if variant == 'error' %}alert-error{% elseif variant == 'success' %}alert-success{% else %}bg-surface text-ink{% endif %}" {% if variant == 'error' %}role="alert"{% else %}role="status"{% endif %}>
        {{ message }}
    </p>
{% endif %}
