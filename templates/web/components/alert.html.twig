{% if message %}
    <div
        class="flex items-start gap-3 rounded-2xl px-4 py-3 text-sm font-medium {% if variant == 'error' %}alert-error{% elseif variant == 'success' %}alert-success{% elseif variant == 'warning' %}alert-warning{% else %}bg-surface text-ink{% endif %}"
        data-controller="alert"
        {% if variant == 'error' or variant == 'warning' %}role="alert"{% else %}role="status"{% endif %}
    >
        <p class="min-w-0">{{ message }}</p>
        <button type="button" class="alert-dismiss" data-action="alert#dismiss" aria-label="{{ 'form.close'|trans }}">
            {{ ux_icon('heroicons:x-mark', { class: 'h-5 w-5', 'aria-hidden': 'true' }) }}
        </button>
    </div>
{% endif %}
