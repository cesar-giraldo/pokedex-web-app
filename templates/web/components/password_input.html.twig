<div data-controller="password-input" data-password-input-show-label-value="{{ showLabel }}" data-password-input-hide-label-value="{{ hideLabel }}" data-password-input-disabled-value="{{ disabled ? 'true' : 'false' }}">
    <label class="text-sm font-medium" for="{{ id }}">{{ label }}</label>
    <div class="relative mt-2">
        <input
            id="{{ id }}"
            name="{{ name }}"
            type="password"
            value="{{ value }}"
            class="field pr-12"
            autocomplete="{{ autocomplete }}"
            data-password-input-target="input"
            {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
            {% if maxLength > 0 %}maxlength="{{ maxLength }}"{% endif %}
            {% if required %}required{% endif %}
            {% if disabled %}disabled{% endif %}
            {% if error %}
                aria-invalid="true"
                aria-describedby="{{ id }}-error{% if help %} {{ id }}-help{% endif %}"
            {% elseif help %}
                aria-describedby="{{ id }}-help"
            {% endif %}
        >
        <button
            type="button"
            class="absolute top-1/2 right-4 -translate-y-1/2 text-muted"
            data-password-input-target="toggle"
            data-action="click->password-input#toggleVisibility"
            aria-label="{{ showLabel }}"
            aria-pressed="false"
            {% if disabled %}disabled{% endif %}
        >
            <span data-password-input-target="showIcon">
                {{ ux_icon('heroicons:eye', { class: 'h-5 w-5' }) }}
            </span>
            <span class="hidden" data-password-input-target="hideIcon">
                {{ ux_icon('heroicons:eye-slash', { class: 'h-5 w-5' }) }}
            </span>
        </button>
    </div>
    {% if error %}
        <p id="{{ id }}-error" class="field-error" role="alert">{{ error }}</p>
    {% endif %}
    {% if help %}
        <p id="{{ id }}-help" class="mt-2 text-sm text-muted">{{ help }}</p>
    {% endif %}
</div>
