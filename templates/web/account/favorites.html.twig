{% extends '@web/base.html.twig' %}

{% block title %}{{ 'favorites.title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'favorites.meta_description'|trans }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl px-4 py-8">
        {% include '@web/partials/_breadcrumb.html.twig' with {
            items: [
                { label: 'nav.pokemon'|trans, href: path('app_public_pokedex', {_locale: app.request.locale}) },
                { label: 'favorites.title'|trans },
            ],
        } %}
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight">{{ 'favorites.title'|trans }}</h1>
        <p class="mt-3 max-w-2xl text-muted">{{ 'favorites.intro'|trans }}</p>

        {% include '@web/pokemon/_catalog.html.twig' with {
            page: page,
            types: types,
            catalog_route: 'app_public_favorites',
            empty_message: 'favorites.empty'|trans,
            favorite_gate: favorite_gate,
            favorite_ids: favorite_ids,
            remove_on_unfavorite: true,
        } only %}
    </div>
{% endblock %}
