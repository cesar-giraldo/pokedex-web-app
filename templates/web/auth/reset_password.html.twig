{% extends '@web/base.html.twig' %}

{% from '@web/macros/form.html.twig' import field_error %}

{% block title %}{{ (can_reset ? 'auth.reset_password_title' : 'auth.reset_password_invalid_title')|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'auth.reset_password_description'|trans }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}
{% block extra_meta %}
    <meta name="referrer" content="no-referrer">
{% endblock %}

{% block body %}
    <div class="bg-surface px-4 py-16">
        <div class="mx-auto max-w-md rounded-3xl bg-white p-8 ring-1 ring-black/5">
            {% if can_reset %}
                <h1 class="text-3xl font-extrabold tracking-tight">{{ 'auth.reset_password_title'|trans }}</h1>
                <p class="mt-4 text-sm leading-6 text-muted">{{ 'auth.reset_password_description'|trans }}</p>
                {{ form_start(resetForm, {
                    method: 'POST',
                    attr: { class: 'mt-6 space-y-4', 'data-turbo': 'false' },
                }) }}
                    <twig:web_password_input
                        label="{{ 'auth.password'|trans }}"
                        name="{{ resetForm.plainPassword.vars.full_name }}"
                        id="reset-password"
                        value=""
                        autocomplete="new-password"
                        showLabel="{{ 'account.show_password'|trans }}"
                        hideLabel="{{ 'account.hide_password'|trans }}"
                        :maxLength="form_field_max_length(resetForm.plainPassword)"
                        :required="true"
                        error="{{ field_error(resetForm.plainPassword) }}"
                        help="{{ 'auth.password_hint'|trans }}"
                    />
                    <twig:web_password_input
                        label="{{ 'auth.password_confirm'|trans }}"
                        name="{{ resetForm.confirmPassword.vars.full_name }}"
                        id="reset-password-confirm"
                        value=""
                        autocomplete="new-password"
                        showLabel="{{ 'account.show_password'|trans }}"
                        hideLabel="{{ 'account.hide_password'|trans }}"
                        :maxLength="form_field_max_length(resetForm.confirmPassword)"
                        :required="true"
                        error="{{ field_error(resetForm.confirmPassword) }}"
                    />
                    {{ form_widget(resetForm._token) }}
                    <twig:web_submit_button label="{{ 'auth.reset_password_submit'|trans }}" />
                {{ form_end(resetForm, { render_rest: false }) }}
            {% else %}
                <h1 class="text-3xl font-extrabold tracking-tight">{{ 'auth.reset_password_invalid_title'|trans }}</h1>
                <p class="mt-4 text-sm leading-6 text-muted">{{ 'auth.reset_password_invalid'|trans }}</p>
                <p class="mt-6 text-sm">
                    <a class="font-semibold text-brand" href="{{ path('app_public_forgot_password', {_locale: app.request.locale}) }}">{{ 'auth.reset_password_request_again'|trans }}</a>
                </p>
            {% endif %}
            <p class="mt-6 text-sm text-muted">
                <a class="font-semibold text-brand" href="{{ path('app_public_login', {_locale: app.request.locale}) }}">{{ 'auth.forgot_password_back'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
