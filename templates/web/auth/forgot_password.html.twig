{% extends '@web/base.html.twig' %}

{% from '@web/macros/form.html.twig' import field_error %}

{% block title %}{{ 'auth.forgot_password_title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'auth.forgot_password_description'|trans }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="bg-surface px-4 py-16">
        <div class="mx-auto max-w-md rounded-3xl bg-white p-8 ring-1 ring-black/5">
            <h1 class="text-3xl font-extrabold tracking-tight">{{ 'auth.forgot_password_title'|trans }}</h1>
            <p class="mt-4 text-sm leading-6 text-muted">{{ 'auth.forgot_password_description'|trans }}</p>
            <div class="mt-6 space-y-3">
                {% for message in app.flashes('success') %}
                    <twig:web_alert variant="success" message="{{ message|trans }}" />
                {% endfor %}
                {% for error in requestForm.vars.errors %}
                    <twig:web_alert variant="error" message="{{ error.message }}" />
                {% endfor %}
            </div>
            {{ form_start(requestForm, {
                action: path('app_public_forgot_password', {_locale: app.request.locale}),
                method: 'POST',
                attr: { class: 'mt-6 space-y-4', 'data-turbo': 'false' },
            }) }}
                <twig:web_text_input
                    label="{{ 'auth.forgot_password_identifier'|trans }}"
                    name="{{ requestForm.identifier.vars.full_name }}"
                    id="forgot-password-identifier"
                    value="{{ requestForm.identifier.vars.value|default('') }}"
                    autocomplete="username"
                    :maxLength="form_field_max_length(requestForm.identifier)"
                    :required="true"
                    error="{{ field_error(requestForm.identifier) }}"
                />
                {{ form_widget(requestForm._token) }}
                <twig:web_submit_button label="{{ 'auth.forgot_password_submit'|trans }}" />
            {{ form_end(requestForm, { render_rest: false }) }}
            <p class="mt-6 text-sm text-muted">
                <a class="font-semibold text-brand" href="{{ path('app_public_login', {_locale: app.request.locale}) }}">{{ 'auth.forgot_password_back'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
