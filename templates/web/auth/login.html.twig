{% extends '@web/base.html.twig' %}

{% from '@web/macros/form.html.twig' import field_error %}

{% block title %}{{ 'auth.login_title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'auth.login_description'|trans }}{% endblock %}
{% block robots %}noindex, follow{% endblock %}

{% block body %}
    <div class="bg-surface px-4 py-16">
        <div class="mx-auto max-w-md rounded-3xl bg-white p-8 ring-1 ring-black/5">
            <h1 class="text-3xl font-extrabold tracking-tight">{{ 'auth.login_title'|trans }}</h1>
            <div class="mt-6 space-y-3">
                {% for message in app.flashes('error') %}
                    <twig:web_alert variant="error" message="{{ message|trans }}" />
                {% endfor %}
                {% if error %}
                    <twig:web_alert variant="error" message="{{ error.messageKey|trans(error.messageData, 'security') }}" />
                {% endif %}
            </div>
            <div class="mt-8">
                {% include '@web/auth/_google.html.twig' with {from: 'login'} only %}
            </div>
            <p class="mt-6 text-sm leading-6 text-muted">{{ 'auth.login_description'|trans }}</p>
            {{ form_start(loginForm, {
                action: path('app_public_login', {_locale: app.request.locale}),
                method: 'POST',
                attr: { class: 'mt-4 space-y-4', 'data-turbo': 'false' },
            }) }}
                <twig:web_text_input
                    label="{{ 'auth.login_identifier'|trans }}"
                    name="{{ loginForm['_username'].vars.full_name }}"
                    id="login-nickname"
                    value="{{ loginForm['_username'].vars.value }}"
                    autocomplete="username"
                    :maxLength="form_field_max_length(loginForm['_username'])"
                    :required="true"
                    error="{{ field_error(loginForm['_username']) }}"
                />
                <twig:web_password_input
                    label="{{ 'auth.password'|trans }}"
                    name="{{ loginForm['_password'].vars.full_name }}"
                    id="login-password"
                    autocomplete="current-password"
                    showLabel="{{ 'account.show_password'|trans }}"
                    hideLabel="{{ 'account.hide_password'|trans }}"
                    :maxLength="form_field_max_length(loginForm['_password'])"
                    :required="true"
                    error="{{ field_error(loginForm['_password']) }}"
                />
                <twig:web_checkbox
                    label="{{ 'auth.remember'|trans }}"
                    name="{{ loginForm['_remember_me'].vars.full_name }}"
                    id="login-remember"
                    value="on"
                    :checked="loginForm['_remember_me'].vars.checked"
                />
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_public') }}">
                <twig:web_submit_button label="{{ 'auth.submit_login'|trans }}" />
            {{ form_end(loginForm, { render_rest: false }) }}
            <p class="mt-6 text-sm text-muted">
                {{ 'auth.no_account'|trans }}
                <a class="font-semibold text-brand" href="{{ path('app_public_register', {_locale: app.request.locale}) }}">{{ 'nav.register'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
