{% extends '@web/base.html.twig' %}

{% from '@web/macros/form.html.twig' import field_error %}

{% block title %}{{ 'auth.register_title'|trans }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'auth.register_description'|trans }}{% endblock %}
{% block robots %}noindex, follow{% endblock %}

{% block body %}
    <div class="bg-surface px-4 py-16">
        <div class="mx-auto max-w-md rounded-3xl bg-white p-8 ring-1 ring-black/5 lg:max-w-xl">
            <h1 class="text-3xl font-extrabold tracking-tight">{{ 'auth.register_title'|trans }}</h1>
            <div class="mt-6 space-y-3">
                {% for message in app.flashes('error') %}
                    <twig:web_alert variant="error" message="{{ message|trans }}" />
                {% endfor %}
                {% for error in registrationForm.vars.errors %}
                    <twig:web_alert variant="error" message="{{ error.message }}" />
                {% endfor %}
            </div>
            <div class="mt-8">
                {% include '@web/auth/_google.html.twig' with {from: 'register'} only %}
            </div>
            <p class="mt-6 text-sm leading-6 text-muted">{{ 'auth.register_description'|trans }}</p>
            {{ form_start(registrationForm, {
                action: path('app_public_register', {_locale: app.request.locale}),
                method: 'POST',
                attr: registrationForm.vars.attr|merge({ class: 'mt-4 space-y-4' }),
            }) }}
                <div class="grid gap-4 lg:grid-cols-2">
                    <twig:web_text_input
                        label="{{ 'auth.name'|trans }}"
                        name="{{ registrationForm.name.vars.full_name }}"
                        id="register-name"
                        value="{{ registrationForm.name.vars.value }}"
                        autocomplete="given-name"
                        :maxLength="form_field_max_length(registrationForm.name)"
                        :required="true"
                        error="{{ field_error(registrationForm.name) }}"
                    />
                    <twig:web_text_input
                        label="{{ 'account.lastname'|trans }}"
                        name="{{ registrationForm.lastname.vars.full_name }}"
                        id="register-lastname"
                        value="{{ registrationForm.lastname.vars.value }}"
                        autocomplete="family-name"
                        :maxLength="form_field_max_length(registrationForm.lastname)"
                        :required="true"
                        error="{{ field_error(registrationForm.lastname) }}"
                    />
                </div>
                <twig:web_text_input
                    label="{{ 'auth.email'|trans }}"
                    name="{{ registrationForm.email.vars.full_name }}"
                    id="register-email"
                    type="email"
                    value="{{ registrationForm.email.vars.value }}"
                    autocomplete="email"
                    :maxLength="form_field_max_length(registrationForm.email)"
                    :required="true"
                    error="{{ field_error(registrationForm.email) }}"
                />
                <div class="grid gap-4 lg:grid-cols-2">
                    <twig:web_password_input
                        label="{{ 'auth.password'|trans }}"
                        name="{{ registrationForm.password.vars.full_name }}"
                        id="register-password"
                        autocomplete="new-password"
                        showLabel="{{ 'account.show_password'|trans }}"
                        hideLabel="{{ 'account.hide_password'|trans }}"
                        :maxLength="form_field_max_length(registrationForm.password)"
                        :required="true"
                        error="{{ field_error(registrationForm.password) }}"
                        help="{{ 'auth.password_hint'|trans }}"
                    />
                    <twig:web_password_input
                        label="{{ 'auth.password_confirm'|trans }}"
                        name="{{ registrationForm.passwordConfirm.vars.full_name }}"
                        id="register-password-confirm"
                        autocomplete="new-password"
                        showLabel="{{ 'account.show_password'|trans }}"
                        hideLabel="{{ 'account.hide_password'|trans }}"
                        :maxLength="form_field_max_length(registrationForm.passwordConfirm)"
                        :required="true"
                        error="{{ field_error(registrationForm.passwordConfirm) }}"
                    />
                </div>
                {{ form_widget(registrationForm.timezone, { attr: { 'data-registration-preferences-target': 'timezone' } }) }}
                {{ form_widget(registrationForm.locale, { attr: { 'data-registration-preferences-target': 'locale' } }) }}
                {{ form_widget(registrationForm.timeFormat, { attr: { 'data-registration-preferences-target': 'timeFormat' } }) }}
                <div class="sr-only" aria-hidden="true">
                    <label for="register-fax">Fax</label>
                    <input
                        id="register-fax"
                        name="{{ registrationForm.companyFax.vars.full_name }}"
                        type="text"
                        value="{{ registrationForm.companyFax.vars.value }}"
                        tabindex="-1"
                        autocomplete="off"
                    >
                </div>
                {% if legal_documents is not empty %}
                    {% set terms_document = null %}
                    {% set privacy_document = null %}
                    {% for document in legal_documents %}
                        {% if document.terms %}
                            {% set terms_document = document %}
                        {% elseif document.privacy %}
                            {% set privacy_document = document %}
                        {% endif %}
                    {% endfor %}
                    <div>
                        <label class="flex items-start gap-2 text-sm" for="register-terms">
                            <input
                                id="register-terms"
                                name="{{ registrationForm.terms.vars.full_name }}"
                                type="checkbox"
                                value="{{ registrationForm.terms.vars.value }}"
                                class="mt-1 h-4 w-4 accent-brand"
                                {% if registrationForm.terms.vars.checked %}checked{% endif %}
                                required
                                {% if field_error(registrationForm.terms) %}aria-invalid="true" aria-describedby="register-terms-error"{% endif %}
                            >
                            <span>
                                {% if terms_document and privacy_document %}
                                    {{ 'auth.accept_terms'|trans }}
                                    <a class="font-semibold text-brand" href="{{ path(terms_document.routeName, {_locale: app.request.locale}) }}" target="_blank" rel="noopener noreferrer">{{ 'nav.terms'|trans }}</a>
                                    {{ 'auth.accept_and'|trans }}
                                    <a class="font-semibold text-brand" href="{{ path(privacy_document.routeName, {_locale: app.request.locale}) }}" target="_blank" rel="noopener noreferrer">{{ 'nav.privacy'|trans }}</a>.
                                {% elseif terms_document %}
                                    {{ 'auth.accept_terms'|trans }}
                                    <a class="font-semibold text-brand" href="{{ path(terms_document.routeName, {_locale: app.request.locale}) }}" target="_blank" rel="noopener noreferrer">{{ 'nav.terms'|trans }}</a>.
                                {% elseif privacy_document %}
                                    {{ 'auth.accept_privacy'|trans }}
                                    <a class="font-semibold text-brand" href="{{ path(privacy_document.routeName, {_locale: app.request.locale}) }}" target="_blank" rel="noopener noreferrer">{{ 'nav.privacy'|trans }}</a>.
                                {% endif %}
                            </span>
                        </label>
                        {% if field_error(registrationForm.terms) %}
                            <p id="register-terms-error" class="field-error" role="alert">{{ field_error(registrationForm.terms) }}</p>
                        {% endif %}
                    </div>
                {% endif %}
                {{ form_widget(registrationForm._token) }}
                <twig:web_submit_button label="{{ 'auth.submit_register'|trans }}" />
            {{ form_end(registrationForm, { render_rest: false }) }}
            <p class="mt-6 text-sm text-muted">
                {{ 'auth.has_account'|trans }}
                <a class="font-semibold text-brand" href="{{ path('app_public_login', {_locale: app.request.locale}) }}">{{ 'nav.login'|trans }}</a>
            </p>
        </div>
    </div>
{% endblock %}
