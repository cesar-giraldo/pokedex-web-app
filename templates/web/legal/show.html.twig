{% extends '@web/base.html.twig' %}

{% block title %}{{ translation.title }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block canonical_url %}{{ url(canonical_route, {_locale: app.request.locale}) }}{% endblock %}

{% block body %}
    <article class="mx-auto max-w-3xl px-4 py-14">
        <p class="text-sm font-medium text-muted">{{ 'legal.version'|trans({number: version.versionNumber}) }}</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight">{{ translation.title }}</h1>
        {% if content_language and content_language.value != app.request.locale %}
            <p class="mt-4 rounded-2xl bg-surface px-4 py-3 text-sm text-muted" role="note">
                {{ 'legal.fallback'|trans({language: content_language.nativeName}) }}
            </p>
        {% endif %}
        <div class="legal-copy mt-8">
            {{ translation.contentHtml|raw }}
        </div>
    </article>
{% endblock %}
