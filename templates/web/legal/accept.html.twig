{% extends '@web/base.html.twig' %}

{% block title %}{{ translation.title }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'legal.accept.meta_description'|trans }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="bg-surface px-4 py-8" data-legal-accept>
        <section class="mx-auto max-w-3xl rounded-3xl bg-white ring-1 ring-black/5" aria-labelledby="legal-accept-title">
            <header class="flex items-start justify-between gap-4 border-b border-black/5 px-5 py-5 sm:px-8 sm:py-6">
                <h1 id="legal-accept-title" class="text-2xl font-extrabold tracking-tight text-ink">{{ translation.title }}</h1>
                <p class="shrink-0 text-sm font-medium text-muted">{{ 'legal.version'|trans({number: version.versionNumber}) }}</p>
            </header>
            {% if translation.summary %}
                <p class="px-5 pt-5 text-sm text-muted sm:px-8">{{ translation.summary }}</p>
            {% endif %}
            {% if content_language and content_language.value != app.request.locale %}
                <p class="mx-5 mt-5 rounded-2xl bg-surface px-4 py-3 text-sm text-muted sm:mx-8" role="note">
                    {{ 'legal.fallback'|trans({language: content_language.nativeName}) }}
                </p>
            {% endif %}
            <form method="post" class="px-5 py-5 sm:px-8 sm:py-6">
                <input type="hidden" name="_token" value="{{ csrf_token('public_legal_accept') }}">
                <div class="legal-copy legal-accept-copy rounded-2xl bg-surface p-4 text-sm text-ink" tabindex="0">
                    {{ translation.contentHtml|raw }}
                </div>
                <div class="mt-5">
                    <twig:web_checkbox
                        label="{{ translation.acceptanceLabel }}"
                        name="accepted"
                        id="legal-accepted"
                        value="1"
                        :required="true"
                        error="{{ error }}"
                    />
                </div>
                <div class="mt-6">
                    <twig:web_submit_button
                        label="{{ 'legal.accept.submit'|trans }}"
                        processingLabel="{{ 'legal.accept.processing'|trans }}"
                    />
                </div>
            </form>
        </section>
    </div>
{% endblock %}
