{% extends '@web/base.html.twig' %}

{% block title %}{{ translation.title }} · {{ public_site_name() }}{% endblock %}
{% block meta_description %}{{ 'legal.accept.meta_description'|trans }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="legal-accept-overlay" data-legal-accept>
        <section
            id="legal-accept-dialog"
            class="legal-accept-dialog rounded-3xl bg-white p-5 shadow-lg ring-1 ring-black/5 sm:p-6"
            role="dialog"
            aria-modal="true"
            aria-labelledby="legal-accept-title"
        >
            <header class="flex items-start justify-between gap-4 border-b border-black/5 pb-4">
                <h1 id="legal-accept-title" class="text-2xl font-extrabold tracking-tight text-ink">{{ translation.title }}</h1>
                <p class="shrink-0 text-sm font-medium text-muted">{{ 'legal.version'|trans({number: version.versionNumber}) }}</p>
            </header>
            {% if translation.summary %}
                <p class="mt-4 text-sm text-muted">{{ translation.summary }}</p>
            {% endif %}
            <form method="post" class="mt-4">
                <input type="hidden" name="_token" value="{{ csrf_token('public_legal_accept') }}">
                <div class="legal-copy legal-accept-copy rounded-2xl bg-surface p-4 text-sm text-ink" tabindex="0" autofocus>
                    {{ translation.contentHtml|raw }}
                </div>
                <div class="mt-5">
                    <twig:web_checkbox
                        label="{{ translation.acceptanceLabel }}"
                        name="accepted"
                        id="legal-accepted"
                        value="1"
                        :required="true"
                        error="{{ error }}"
                    />
                </div>
                <div class="mt-6">
                    <twig:web_submit_button
                        label="{{ 'legal.accept.submit'|trans }}"
                        processingLabel="{{ 'legal.accept.processing'|trans }}"
                    />
                </div>
            </form>
        </section>
    </div>
{% endblock %}
