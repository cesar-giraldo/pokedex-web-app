{% set is_admin = app.request.pathInfo starts with '/admin' %}
{% extends is_admin ? '@admin/base_error.html.twig' : '@web/base.html.twig' %}

{% block title %}401 - No autorizado{% endblock %}

{% block body %}
	{% if is_admin %}
		{% include '@admin/error/_401_body.html.twig' %}
	{% else %}
		{% include '@web/error/_401_body.html.twig' %}
	{% endif %}
{% endblock %}
