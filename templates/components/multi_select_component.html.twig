<div data-controller="component-multi-select" data-action="click@window->component-multi-select#close" class="relative" {{attributes}}>

	<label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">
		{{title}}
	</label>

	<div>
		{# El select oculto original sirve como fuente de datos nativa para las opciones #}
		<select class="hidden" id="select" data-component-multi-select-target="select">
			{% for key, value in options|default({ '1': 'Option 2', '2': 'Option 3', '3': 'Option 4', '4': 'Option 5' }) %}
				<option value="{{ key }}">{{ value }}</option>
			{% endfor %}
		</select>

		<div
			class="flex flex-col items-center">
			{# Input oculto real que enviará los valores al servidor Symfony #}
			<input name="values" type="hidden" data-component-multi-select-target="hiddenInput" value=""/>

			<div class="relative z-20 inline-block w-full">
				<div
					class="relative flex flex-col items-center">

					{# El botón de la cabecera que abre el menú desplegable #}
					<div data-action="click->component-multi-select#toggle" class="w-full cursor-pointer">
						<div
							class="shadow-theme-xs focus:border-brand-300 focus:shadow-focus-ring dark:focus:border-brand-300 mb-2 flex h-11 rounded-lg border border-gray-300 py-1.5 pr-3 pl-3 outline-hidden transition dark:border-gray-700 dark:bg-gray-900">

							{# Contenedor de las etiquetas seleccionadas de forma dinámica #}
							<div
								class="flex flex-auto flex-wrap gap-2 items-center" data-component-multi-select-target="tagsContainer">

								{# El placeholder se oculta/muestra mediante JS manipulando la clase hidden #}
								<div data-component-multi-select-target="placeholder" class="flex-1">
									<input placeholder="{{placeholder}}" readonly class="h-full w-full appearance-none border-0 bg-transparent p-1 pr-2 text-sm outline-hidden placeholder:text-gray-800 focus:border-0 focus:ring-0 focus:outline-hidden dark:placeholder:text-white/90"/>
								</div>
							</div>

							{# Flecha de indicador de apertura #}
							<div class="flex w-7 items-center py-1 pr-1 pl-1">
								<button type="button" data-component-multi-select-target="arrow" class="h-5 w-5 cursor-pointer text-gray-700 outline-hidden focus:outline-hidden dark:text-gray-400 transition-transform duration-200">
									<svg class="stroke-current" width="20" height="20" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M4.79175 7.39551L10.0001 12.6038L15.2084 7.39551" stroke="" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</button>
							</div>
						</div>
					</div>

					{# Listado de opciones renderizado en el servidor #}
					<div class="w-full px-4">
						<div data-component-multi-select-target="menu" class="hidden max-h-select absolute top-full left-0 z-40 w-full overflow-y-auto rounded-lg bg-white shadow-sm dark:bg-gray-900 transition-all duration-200">
							<div class="flex w-full flex-col">
								{% for key, value in options|default({ '1': 'Option 2', '2': 'Option 3', '3': 'Option 4', '4': 'Option 5' }) %}
								<div>
									<div class="hover:bg-primary/5 w-full cursor-pointer rounded-t border-b border-gray-200 dark:border-gray-800" data-action="click->component-multi-select#select" data-index="{{ loop.index0 }}" data-value="{{ key }}" data-text="{{ value }}">

										<div data-component-multi-select-target="optionRow" class="relative flex w-full items-center border-l-2 border-transparent p-2 pl-2">
											<div class="flex w-full items-center">
												<div class="mx-2 leading-6 text-gray-800 dark:text-white/90">
													{{ value }}
												</div>
											</div>
										</div>
									</div>
								</div>
							{% endfor %}
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div></div>
