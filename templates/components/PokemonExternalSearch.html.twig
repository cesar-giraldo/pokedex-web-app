<div {{attributes}}>
    <input type="text" 
        class="border rounded px-3 py-2 mr-2"
        placeholder="Nombre del Pokemon"
        data-model="name"
        value="{{ name }}">

    <button type="button" 
        class="px-4 py-2 bg-amber-500 text-white rounded hover:bg-amber-600"
        data-action="live#action"
        data-live-action-param="search">Busqueda Externa</button>

    {% if this.pokemon is not empty %}
        <div class="mt-2">Resultado:</div>
        <table class="table-auto">
            <thead>
                <tr>
                    <th class="px-4 py-2">Imagen</th>
                    <th class="px-4 py-2">Nombre</th>
                    <th class="px-4 py-2">Tipo</th>
                    <th class="px-4 py-2">Altura</th>
                    <th class="px-4 py-2">Peso</th>
                    <th class="px-4 py-2">Velocidad</th>
                    <th class="px-4 py-2">Ataque</th>
                    <th class="px-4 py-2">Defensa</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="border items-center">
                        {% set sprite = this.pokemon.sprites.front_default ?: this.pokemon.sprites.back_default ?: asset('images/pokemon/pokeball.png') %}
                        <img src="{{ sprite }}" alt="{{ this.pokemon.name }}" class="w-20 h-20">
                    </td>
                    <td class="border px-4 py-2">{{ this.pokemon.name }}</td>
                    <td class="border px-4 py-2">{{ this.pokemon.types[0].type.name }}</td>
                    <td class="border px-4 py-2">{{ this.pokemon.height }} pies</td>
                    <td class="border px-4 py-2">{{ this.pokemon.weight }} lbs</td>
                    
                    {% set speed = this.pokemon.stats|find(st => st.stat.name == 'speed') %}
                    {% set attack = this.pokemon.stats|find(st => st.stat.name == 'attack') %}
                    {% set defense = this.pokemon.stats|find(st => st.stat.name == 'defense') %}

                    <td class="border px-4 py-2">{{ speed ? speed.base_stat : 'N/A' }}</td>
                    <td class="border px-4 py-2">{{ attack ? attack.base_stat : 'N/A' }}</td>
                    <td class="border px-4 py-2">{{ defense ? defense.base_stat : 'N/A' }}</td>
                </tr>
            </tbody>
        </table>
    {% else %}
        <p class="text-gray-500">Pokemon no encontrado.</p>
    {% endif %}
</div>