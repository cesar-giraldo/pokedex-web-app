	<span class="inline-flex items-center justify-center gap-1 rounded-full bg-brand-500 py-0.5 pl-2 pr-2.5 text-sm font-medium text-white">
		{{ ux_icon('heroicons:plus-circle', { class: 'w-5 h-5 fill-current' }) }}
