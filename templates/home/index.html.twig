{% extends 'base-old.html.twig' %}

{% block title %}Home · PokeDex{% endblock %}

{% block body %}
<div class="min-h-screen bg-linear-to-br from-blue-50 to-indigo-100 p-8">
    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-lg p-8">
        <h1 class="text-4xl font-bold text-indigo-700 mb-4">
            Listado de Pokemons
        </h1>
        <ul class="divide-y divide-gray-200">
            {% for pokemon in pokemons %}
                <li class="py-3 flex justify-between">
                    <span class="font-medium text-gray-800">{{ pokemon.name }}</span>
                    <span class="text-indigo-600 font-semibold">{{ pokemon.type.name }}</span>
                </li>
            {% else %}
                <li class="py-3 text-gray-500">No hay Pokemons.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-8 p-6 bg-amber-50 rounded-xl border border-amber-200"
        {{ stimulus_controller('hi') }}>
        <h2 class="text-xl font-bold text-amber-700 mb-2">Contenido Dinamico con Stimulus Controllers</h2>
        <input type="text"
            {{ stimulus_target('hi', 'name') }}
            placeholder="Tu nombre"
            class="border rounded px-3 py-2 mr-2">

        <button type="button"
                {{ stimulus_action('hi', 'greet') }}
                class="px-4 py-2 bg-amber-500 text-white rounded hover:bg-amber-600">
            Saludar
        </button>

        <p class="mt-3 text-lg font-medium" {{ stimulus_target('hi', 'output') }}></p>
    </div>

    <div class="mt-8 p-6 bg-green-50 rounded-xl border border-green-200">
        <h2 class="text-xl font-bold text-amber-700 mb-2">Live Component Ajax - Buscar Pokemon</h2>
        {{ component('PokemonInternalSearch', { name: 'Pikachu' }) }}        
    </div>

    <div class="mt-8 p-6 bg-green-50 rounded-xl border border-green-200">
        <h2 class="text-xl font-bold text-amber-700 mb-2">Live Component Ajax - Buscar Pokemon - API Externa</h2>
        {{ component('PokemonExternalSearch', { name: 'Charmander' }) }}        
    </div>

    <div class="mt-8 p-6 bg-amber-50 rounded-xl border border-amber-200" {{ stimulus_controller('search-pokemon') }}>
        <h2 class="text-xl font-bold text-amber-700 mb-2">Buscar Pokemon - Stimulus + Fetch</h2>
        <input type="text" {{ stimulus_target('search-pokemon', 'pokemonName') }} placeholder="Nombre del Pokemon" class="border rounded px-3 py-2 mr-2">

        <button type="button" {{ stimulus_action('search-pokemon', 'search') }} class="px-4 py-2 bg-amber-500 text-white rounded hover:bg-amber-600">
            Buscar API Externa
        </button>

        <button type="button" {{ stimulus_action('search-pokemon', 'internalSearch') }} class="px-4 py-2 bg-amber-500 text-white rounded hover:bg-amber-600">
            Busqueda Interna
        </button>

        <div class="mt-3 text-lg font-medium" {{ stimulus_target('search-pokemon', 'pokemonDetails') }}></div>
        <div {{ stimulus_target('search-pokemon', 'spinner') }} class="hidden">
            {{ ux_icon('heroicons:arrow-path', {class: 'size-6 text-gray-500 hover:text-indigo-600'}) }}
        </div>
    </div>

</div>


{% endblock %}
