<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.password_reset.heading'|trans }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f5;color:#18181b;font-family:Arial,sans-serif;line-height:1.5;">
    <article style="max-width:560px;margin:0 auto;padding:24px;background:#ffffff;">
        <h1 style="margin:0 0 16px;font-size:22px;">{{ 'email.password_reset.heading'|trans }}</h1>
        <p style="margin:0 0 12px;">{{ 'email.password_reset.intro'|trans({name: recipient_name}) }}</p>
        <p style="margin:0 0 20px;">{{ 'email.password_reset.expires'|trans }}</p>
        <p style="margin:0 0 20px;">
            <a href="{{ reset_url }}" style="display:inline-block;padding:12px 20px;background:#820AD1;color:#ffffff;text-decoration:none;border-radius:999px;">{{ 'email.password_reset.action'|trans }}</a>
        </p>
        <p style="margin:0 0 8px;font-size:13px;color:#52525b;">{{ 'email.password_reset.link_hint'|trans }}</p>
        <p style="margin:0 0 20px;font-size:13px;word-break:break-all;">{{ reset_url }}</p>
        <p style="margin:0 0 12px;">{{ 'email.password_reset.ignore'|trans }}</p>
        <p style="margin:0;font-size:13px;color:#52525b;">{{ 'email.password_reset.footer'|trans }}</p>
    </article>
</body>
</html>
