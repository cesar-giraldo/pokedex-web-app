<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email.password_reset_completed.heading'|trans }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f5;color:#18181b;font-family:Arial,sans-serif;line-height:1.5;">
    <article style="max-width:560px;margin:0 auto;padding:24px;background:#ffffff;">
        <h1 style="margin:0 0 16px;font-size:22px;">{{ 'email.password_reset_completed.heading'|trans }}</h1>
        <p style="margin:0 0 12px;">{{ 'email.password_reset_completed.intro'|trans({name: recipient_name}) }}</p>
        <p style="margin:0 0 12px;">{{ 'email.password_reset_completed.detail'|trans }}</p>
        <p style="margin:0 0 12px;">{{ 'email.password_reset_completed.when'|trans({when: changed_at}) }}</p>
        {% if channel == 'web' and contact_url %}
            <p style="margin:0 0 12px;">{{ 'email.password_reset_completed.not_you'|trans }}</p>
            <p style="margin:0 0 20px;">
                <a href="{{ contact_url }}">{{ 'email.password_reset_completed.contact_action'|trans }}</a>
            </p>
        {% else %}
            <p style="margin:0 0 20px;">{{ 'email.password_reset_completed.not_you_email'|trans({email: contact_email}) }}</p>
        {% endif %}
        <p style="margin:0;font-size:13px;color:#52525b;">{{ 'email.password_reset_completed.footer'|trans }}</p>
    </article>
</body>
</html>
