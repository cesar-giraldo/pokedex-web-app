{% extends 'base.html.twig' %}

{% block title %}Pie Chart
{% endblock %}

{% block page_title %}
	Pie Chart
{% endblock %}

{% block breadcrumb %}
	<li class="text-sm text-gray-800 dark:text-white/90">Pie Chart</li>
{% endblock %}

{% block body %}
	<div class="space-y-6">
		<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
			<div class="px-6 py-5">
				<h3 class="text-base font-medium text-gray-800 dark:text-white/90">
					Ventas por Categorias de Productos
				</h3>
			</div>
			<div
				class="p-5 border-t border-gray-100 dark:border-gray-800 sm:p-6">
				<!-- ====== Pie Chart Start -->
				<div 
					data-controller="template-pie-chart" 
					data-template-pie-chart-data-value="{{ data|json_encode }}"
					data-template-pie-chart-labels-value="{{ labels|json_encode }}"
					class="max-w-full overflow-x-auto custom-scrollbar">
						<div data-template-pie-chart-target="container" class="min-w-[1000px]"></div>
				</div>
				<!-- ====== Pie Chart End -->
			</div>
		</div>
	</div>
{% endblock %}
