# Copia este archivo a /srv/pokedex/clients/<cliente>/.env y rellena los huecos.
# Docker env_file no interpola ${...} y no quita comillas. Escribe los valores literales.
# chmod 600 .env

COMPOSE_PROJECT_NAME=pokedex
CLIENT_ALIAS=pokedex

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=

DEFAULT_URI=https://pokedex.tutoyotaseminuevo.com
TRUSTED_HOSTS=^pokedex\.tutoyotaseminuevo\.com$
TRUSTED_PROXIES=REMOTE_ADDR

DATABASE_ENGINE=postgresql
DATABASE_NAME=app_pokedex
DATABASE_USER=app
DATABASE_PASSWORD=
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_SERVER_VERSION=18
DATABASE_CHARSET=utf8
# La misma contraseña, con los caracteres reservados de una URL codificados.
DATABASE_URL=postgresql://app:@database:5432/app_pokedex?serverVersion=18&charset=utf8

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pokedex-444040489724
AWS_S3_STORAGE_PREFIX=pokedex

AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=
MAILER_FROM_NAME=Pokedex
MAILER_REDIRECT_TO=

# El .env de la imagen ya apunta a http://gotenberg:3000. Cámbialo solo si el alias cambia.
GOTENBERG_HOST=gotenberg
GOTENBERG_PORT=3000
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=30

CORS_ALLOW_ORIGIN=^https://pokedex\.tutoyotaseminuevo\.com$

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
